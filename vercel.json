{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "ignoreCommand": "node scripts/vercel-ignore-build.mjs",
  "git": {
    "deploymentEnabled": {
      "**": false,
      "live": true
    }
  },
  "crons": [
    {
      "path": "/api/cron/launch-emails",
      "schedule": "0 16 * * *"
    },
    {
      "path": "/api/cron/billing-reminders",
      "schedule": "0 14 * * *"
    },
    {
      "path": "/api/cron/job-reminders",
      "schedule": "0 13 * * *"
    },
    {
      "path": "/api/cron/start-renewals",
      "schedule": "10 7 * * *"
    },
    {
      "path": "/api/cron/late-fees",
      "schedule": "0 15 * * *"
    },
    {
      "path": "/api/cron/billing-reconcile",
      "schedule": "30 15 * * *"
    },
    {
      "path": "/api/cron/backup",
      "schedule": "0 9 * * *"
    },
    {
      "path": "/api/cron/telecom-sync",
      "schedule": "20 9 * * *"
    },
    {
      "path": "/api/cron/books-nightly",
      "schedule": "40 9 * * *"
    },
    {
      "path": "/api/cron/estimate-follow-ups",
      "schedule": "0 16 * * *"
    },
    {
      "path": "/api/cron/tax-address-recheck",
      "schedule": "20 13 * * *"
    },
    {
      "path": "/api/cron/tax-rate-changes",
      "schedule": "5 18 * * *"
    },
    {
      "path": "/api/cron/tenant-retention",
      "schedule": "30 10 * * *"
    },
    {
      "path": "/api/cron/expense-drafts",
      "schedule": "50 9 * * *"
    },
    {
      "path": "/api/cron/scheduled-prices",
      "schedule": "10 10 * * *"
    }
  ]
}
