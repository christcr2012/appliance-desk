  voidedByUserId String?
  voidedReason String?
  version Int @default(1)
  items BankMatchItem[]

  @@index([cashAccountId])
}

model BankMatchItem {
  id String @id @default(cuid())
  groupId String
  group BankMatchGroup @relation(fields: [groupId], references: [id], onDelete: Restrict)
  bankObservationId String?
  observation BankObservation? @relation(fields: [bankObservationId], references: [id], onDelete: Restrict)
  journalLineId String?
  journalLine JournalLine? @relation(fields: [journalLineId], references: [id], onDelete: Restrict)
