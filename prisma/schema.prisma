// COM-L3: private, per-user communication timelines; provider dispatch remains disabled.
enum CommunicationThreadResolution {
  UNRESOLVED
  AMBIGUOUS
  RESOLVED
}
enum CommunicationThreadStatus {
  OPEN
  WAITING
  CLOSED
}
enum CommunicationMessageDirection {
  INBOUND
  OUTBOUND
}
enum CommunicationLinkSource {
  EXPLICIT
  WORKFLOW
  STAFF_CONFIRMED
}
enum CommunicationLinkEntityType {
  Customer
  Lead
  ServiceAddress
  RentalAgreement
  Job
  MaintenanceRequest
  Invoice
  Estimate
}

model CommunicationThread {
  id String @id @default(cuid())
  accountId String
  account TelecomAccount @relation(fields:[accountId],references:[id],onDelete:Restrict)
  businessNumberId String
  businessNumber BusinessPhoneNumber @relation(fields:[accountId,businessNumberId],references:[accountId,id],onDelete:Restrict)
  externalContactPointId String
  externalContactPoint ContactPoint @relation(fields:[externalContactPointId],references:[id],onDelete:Restrict)
  customerId String?
  customer Customer? @relation(fields:[customerId],references:[id],onDelete:Restrict)
  leadId String?
  lead Lead? @relation(fields:[leadId],references:[id],onDelete:Restrict)
  resolution CommunicationThreadResolution @default(UNRESOLVED)
  status CommunicationThreadStatus @default(OPEN)
  assignedUserId String?
  assignedUser User? @relation("CommunicationThreadAssignee",fields:[assignedUserId],references:[id],onDelete:Restrict)
  version Int @default(1)
  lastActivityAt DateTime @default(now())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  messages CommunicationMessage[]
  callSessions CallSession[]
  readMarkers CommunicationReadMarker[]
  @@unique([accountId,businessNumberId,externalContactPointId])
  @@unique([accountId,id])
  @@index([status,lastActivityAt,id])
  @@index([assignedUserId])
  @@index([customerId])
  @@index([leadId])
}

model CommunicationReadMarker {
  id String @id @default(cuid())
  threadId String
  thread CommunicationThread @relation(fields:[threadId],references:[id],onDelete:Restrict)
  userId String
  user User @relation(fields:[userId],references:[id],onDelete:Restrict)
  lastReadOccurredAt DateTime?
  lastReadMessageId String?
  lastReadMessage CommunicationMessage? @relation("CommunicationReadPosition",fields:[threadId,lastReadMessageId],references:[threadId,id],onDelete:Restrict)
  updatedAt DateTime @updatedAt
  @@unique([threadId,userId])
}

model CommunicationMessage {
  id String @id @default(cuid())
  threadId String
  thread CommunicationThread @relation(fields:[accountId,threadId],references:[accountId,id],onDelete:Restrict)
  direction CommunicationMessageDirection
  deliveryId String? @unique
  delivery MessageDelivery? @relation(fields:[deliveryId],references:[id],onDelete:Restrict)
  providerResourceId String?
  accountId String
  account TelecomAccount @relation(fields:[accountId],references:[id],onDelete:Restrict)
  bodyEncrypted String?
  bodyHash String
  occurredAt DateTime
  receivedAt DateTime @default(now())
  actorUserId String?
  actorUser User? @relation("CommunicationMessageActor",fields:[actorUserId],references:[id],onDelete:Restrict)
  consentRecordId String?
  consentRecord ConsentRecord? @relation(fields:[consentRecordId],references:[id],onDelete:Restrict)
  redactedAt DateTime?
  links CommunicationLink[]
  readMarkers CommunicationReadMarker[] @relation("CommunicationReadPosition")
  @@unique([accountId,providerResourceId])
  @@unique([threadId,id])
  @@index([threadId,occurredAt,id])
}

model CommunicationLink {
  id String @id @default(cuid())
  messageId String
  message CommunicationMessage @relation(fields:[messageId],references:[id],onDelete:Restrict)
  entityType CommunicationLinkEntityType
  entityId String
  source CommunicationLinkSource
  createdAt DateTime @default(now())
  actorUserId String?
  actorUser User? @relation("CommunicationLinkActor",fields:[actorUserId],references:[id],onDelete:Restrict)
  @@unique([messageId,entityType,entityId])
  @@index([entityType,entityId])
}

model CommunicationTemplateRevision {
  id String @id @default(cuid())
  key String
  revision Int
  channel MessageChannel
  purpose MessagePurpose
  body String
  subject String?
  triggerKey String?
  variables Json @default("{}")
  policy Json @default("{}")
  isCurrent Boolean @default(false)
