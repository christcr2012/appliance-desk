  records         RetailDeliveryFeeRecord[]
  createdAt       DateTime @default(now())
}

model RetailDeliveryFeeRecord {
  id                       String @id @default(cuid())
  saleKey                  String @unique
  firstJobId               String?
  firstJob                 Job? @relation("RdfFirstJob", fields: [firstJobId], references: [id], onDelete: Restrict)
  agreementId              String?
  agreement                RentalAgreement? @relation("RdfAgreement", fields: [agreementId], references: [id], onDelete: Restrict)
  invoiceId                String?
  invoice                  Invoice? @relation("RdfShopInvoice", fields: [invoiceId], references: [id], onDelete: Restrict)
  deliveredOn              DateTime
  saleOn                   DateTime?
  customerRefundedAt       DateTime?
  customerRefundRef        String?
  creditAppliedPeriodId    String?
  creditAppliedPeriod      TaxFilingPeriod? @relation("RdfCreditPeriod", fields: [creditAppliedPeriodId], references: [id], onDelete: Restrict)
  status                   RdfRecordStatus
  rateId                   String?
  rate                     RetailDeliveryFeeRate? @relation(fields: [rateId], references: [id], onDelete: Restrict)
  // TFA-1: the dated rule version that set the amount (co.rdf.amount). New
  // records use this; rateId stays for rows recorded before TFA-1.
  ruleVersionId            String?
  ruleVersion              LegalRuleVersion? @relation("RdfRuleVersion", fields: [ruleVersionId], references: [id], onDelete: Restrict)
  amountCents              Int?
  collectedFromCustomer    Boolean?
  invoiceLineId            String? @unique
  invoiceLine              InvoiceLineItem? @relation("RdfInvoiceLine", fields: [invoiceLineId], references: [id], onDelete: Restrict)
  filingPeriodId           String?
