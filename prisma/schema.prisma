  createdAt       DateTime           @default(now())
}

model ExportBatchEntry {
  exportBatchId  String
  batch          ExportBatch  @relation(fields: [exportBatchId], references: [id], onDelete: Cascade)
  journalEntryId String
  entry          JournalEntry @relation(fields: [journalEntryId], references: [id])

  @@id([exportBatchId, journalEntryId])
  @@index([journalEntryId])
}


// K-CASH-4A: zero-money budget state; every funding mutation locks this singleton
// before BooksPostingRevision, bank account, and sorted envelope/source rows.
// K-CASH-7: immutable published monthly budget versions and private month-end reviews.
// Never inferred from later actuals or overwritten by edits to live schedules or names.
model BudgetPlanVersion {
  id String @id @default(cuid())
  monthKey String
  version Int
  commandKey String @unique
  publishedAt DateTime @default(now())
  publishedByUserId String
  publishedBy User @relation("BudgetPlanPublisher",fields:[publishedByUserId],references:[id],onDelete:Restrict)
  sourceRevision BigInt
  budgetRevision BigInt
  schemaVersion Int @default(1)
  payload Json
  sha256 String
  note String
  supersedesId String? @unique
  supersedes BudgetPlanVersion? @relation("BudgetPlanSupersession",fields:[supersedesId],references:[id],onDelete:Restrict)
  replacements BudgetPlanVersion[] @relation("BudgetPlanSupersession")

  @@unique([monthKey,version])
  @@index([monthKey,publishedAt])
}

model BudgetReviewSnapshot {
  id String @id @default(cuid())
  commandKey String @unique
  monthKey String
  createdAt DateTime @default(now())
  createdByUserId String
  createdBy User @relation("BudgetReviewCreator",fields:[createdByUserId],references:[id],onDelete:Restrict)
  sourceRevision BigInt
  budgetRevision BigInt
  schemaVersion Int @default(1)
  payload Json
  sha256 String

  @@index([monthKey,createdAt])
}

model BudgetState {
  readinessAttestation Json?
  id String @id @default("singleton")
  revision BigInt @default(1)
  startOn DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// No monetary balance column: all discretionary balances derive from signed
// immutable BudgetMove history; protected debts derive from K liability journals.
model BudgetEnvelope {
  id String @id @default(cuid())
  name String
  groupLabel String @default("Discretionary")
  sortOrder Int @default(0)
  active Boolean @default(true)
  version Int @default(1)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  moves BudgetMove[]
  splits BudgetSpendSplit[]
  target BudgetTarget?
  costPlans BudgetCostPlan[]

  @@index([active,sortOrder])
}

model BudgetMove {
  id String @id @default(cuid())
  commandKey String
  payloadHash String
  resultRevision BigInt?
  envelopeId String
  envelope BudgetEnvelope @relation(fields:[envelopeId],references:[id],onDelete:Restrict)
  signedCents Int
  kind String
  sourceType String?
  sourceId String?
  eventKind String?
  reason String
  actorId String?
  actor User? @relation(fields:[actorId],references:[id],onDelete:Restrict)
  reversalOfId String? @unique
  reversalOf BudgetMove? @relation("BudgetMoveReversal",fields:[reversalOfId],references:[id],onDelete:Restrict)
  laterReversals BudgetMove[] @relation("BudgetMoveReversal")
  createdAt DateTime @default(now())

  @@unique([commandKey,envelopeId,kind])
  @@index([envelopeId,createdAt])
  @@index([sourceType,sourceId,eventKind])
  @@index([actorId])
}

model BudgetSpendSplit {
  active Boolean @default(true)
  reversedAt DateTime?
  reversedReason String?
  id String @id @default(cuid())
  journalLineId String
  journalLine JournalLine @relation(fields:[journalLineId],references:[id],onDelete:Restrict)
  envelopeId String
  envelope BudgetEnvelope @relation(fields:[envelopeId],references:[id],onDelete:Restrict)
  amountCents Int
  version Int @default(1)

  @@index([journalLineId,envelopeId])
  @@index([envelopeId])
}

model BudgetTarget {
  id String @id @default(cuid())
  envelopeId String @unique
  envelope BudgetEnvelope @relation(fields:[envelopeId],references:[id],onDelete:Restrict)
  kind String
  amountCents Int
  dueOn DateTime?
  repeat String @default("NONE")
  active Boolean @default(true)
  cycleStartOn DateTime?
  version Int @default(1)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model BudgetCostPlan {
  id String @id @default(cuid())
  envelopeId String
  envelope BudgetEnvelope @relation(fields:[envelopeId],references:[id],onDelete:Restrict)
  name String
  amountCents Int
  amountQuality String
  dueOn DateTime
  recurrence String @default("NONE")
  anchorDay Int
  anchorMonth Int?
  sourceType String @default("MANUAL")
  sourceId String?
  active Boolean @default(true)
  version Int @default(1)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  occurrences BudgetCostOccurrence[]

  @@index([envelopeId,active])
  @@index([dueOn])
  @@index([sourceType,sourceId])
}

model BudgetCostOccurrence {
  id String @id @default(cuid())
  planId String
  plan BudgetCostPlan @relation(fields:[planId],references:[id],onDelete:Restrict)
  dueOn DateTime
  amountCents Int
  status String @default("PLANNED")
  sourceRevision Int @default(1)
  version Int @default(1)
  settlements BudgetCostSettlement[]

  @@unique([planId,dueOn])
  @@index([status,dueOn])
}

model BudgetCostSettlement {
  id String @id @default(cuid())
  occurrenceId String
  occurrence BudgetCostOccurrence @relation(fields:[occurrenceId],references:[id],onDelete:Restrict)
  sourceType String
  sourceId String
  amountCents Int
  commandKey String @unique
  payloadHash String
  reversalOfId String? @unique
  reversalOf BudgetCostSettlement? @relation("BudgetSettlementReversal",fields:[reversalOfId],references:[id],onDelete:Restrict)
  laterReversals BudgetCostSettlement[] @relation("BudgetSettlementReversal")
  createdAt DateTime @default(now())

  @@index([occurrenceId])
  @@index([sourceType,sourceId])
}


/// The owner's own business paperwork (LLC, EIN, licenses, insurance, yearly filings) with renewal reminders.
/// Owner-only. `referenceNumber` holds things like an EIN or license number, so it is never logged or shown to staff.
enum PaperworkStatus {
  TO_DO
  IN_PROGRESS
  DONE
  NOT_NEEDED
}

model BusinessPaperwork {
  id               String          @id @default(cuid())
  /// Set for items from the starter checklist (unique, so adding the checklist twice does nothing).
  templateKey      String?         @unique
  title            String
  groupName        String
  whatItIs         String?
  agency           String?
  officialUrl      String?
  status           PaperworkStatus @default(TO_DO)
  referenceNumber  String?
  startedOn        DateTime?
  /// Next renewal, expiry or filing date. Business date (Denver midnight).
  dueOn            DateTime?
  remindDaysBefore Int             @default(30)
  repeatEveryMonths Int?
  notes            String?
  sortOrder        Int             @default(0)
  lastDoneOn       DateTime?
  createdByUserId  String?
  updatedByUserId  String?
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt
  version          Int             @default(1)

  @@index([status, dueOn])
}

// O-5: a monthly target for one business number (cash collected, or new rentals). One per metric per Colorado month.
model BusinessGoal {
  id          String   @id @default(cuid())
  metricKey   String
  // First day of the Colorado month this target is for, stored as that day's Colorado midnight.
  month       DateTime
  targetValue Int
  createdByUserId String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([metricKey, month])
}

// O-7: one private workspace row per owner/admin: pinned shortcuts, hidden optional Today notes, saved views.
// `preferences` is a strict versioned DTO validated in src/domains/workspace/preferences.ts. No URLs, SQL, customer data or secrets.
model OwnerWorkspacePreference {
  userId      String   @id
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  version     Int      @default(1)
  preferences Json
  updatedAt   DateTime @updatedAt
}

// ACC-5: a named list of desk screens on top of an access level. It can only narrow what the level allows, never widen.
// The four starting roles are inserted by the migration (isStarter) and can be edited or archived by the owner.
model JobRole {
  id               String    @id @default(cuid())
  label            String
  accessLevel      Role
  screens          Json      @default("[]")
  capabilityLimits Json      @default("[]")
  isStarter        Boolean   @default(false)
  archivedAt       DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@index([archivedAt])
}

// A stored picture or receipt file that nothing needs any more (a receipt page that was removed, a photo a customer took
// off a request before sending it). The file is deleted by the nightly clean-up after a waiting period, and only if no
// record still points at it. Never holds the file itself.
model StoredFileCleanup {
  id         String    @id @default(cuid())
  url        String    @unique
  reason     String
  queuedAt   DateTime  @default(now())
  deleteAfter DateTime
  // WAITING -> DELETED, or KEPT (something started using it again), or FAILED (could not be deleted after several tries).
  state      String    @default("WAITING")
  attempts   Int       @default(0)
  finishedAt DateTime?
  note       String?

  @@index([state, deleteAfter])
}

// ---------------------------------------------------------------------------
// MCP-10a: the in-app "App feedback" box (people only). Owners, staff and customers report a problem with this app or
// suggest an improvement; the owner and admins answer inside the app. Never appliance repairs (those are
// MaintenanceRequest). No AI or ops access in this unit: every report is HUMAN_ONLY.
// ---------------------------------------------------------------------------
model FeedbackReport {
  id               String             @id @default(cuid())
  number           Int                @unique @default(autoincrement())
  reporterUserId   String
  reporter         User               @relation("FeedbackReporter", fields: [reporterUserId], references: [id], onDelete: Restrict)
  reporterRole     Role
  kind             FeedbackKind
  title            String             @db.VarChar(160)
  description      String             @db.VarChar(8000)
  expected         String?            @db.VarChar(2000)
  steps            String?            @db.VarChar(4000)
  routeTemplate    String             @db.VarChar(200)
  appRevision      String?            @db.VarChar(40)
  safeContext      Json
  aiReview         FeedbackAiReview   @default(HUMAN_ONLY)
  state            FeedbackState      @default(SUBMITTED)
  awaitingTeam     Boolean            @default(true)
  duplicateOfId    String?
  duplicateOf      FeedbackReport?    @relation("FeedbackDuplicate", fields: [duplicateOfId], references: [id], onDelete: SetNull)
  duplicates       FeedbackReport[]   @relation("FeedbackDuplicate")
  requestKey       String             @db.VarChar(64)
  contentRemovedAt DateTime?
  version          Int                @default(1)
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt
  closedAt         DateTime?
  entries          FeedbackEntry[]
  attachments      FeedbackAttachment[]
  events           FeedbackEvent[]

  @@unique([reporterUserId, requestKey])
  @@index([reporterUserId, createdAt, id])
  @@index([state, kind, updatedAt, id])
}

model FeedbackEntry {
  id           String             @id @default(cuid())
  reportId     String
  report       FeedbackReport     @relation(fields: [reportId], references: [id], onDelete: Cascade)
  authorUserId String
  author       User               @relation("FeedbackEntryAuthor", fields: [authorUserId], references: [id], onDelete: Restrict)
  visibility   FeedbackVisibility
  body         String             @db.VarChar(4000)
  createdAt    DateTime           @default(now())

  @@index([reportId, createdAt, id])
}

model FeedbackAttachment {
  id         String         @id @default(cuid())
  reportId   String
  report     FeedbackReport @relation(fields: [reportId], references: [id], onDelete: Cascade)
  uploaderId String
  // feedback/{reportId}/{id}.webp in the PRIVATE store.
  pathname   String         @unique
  sizeBytes  Int
  sha256     String         @db.Char(64)
  width      Int
  height     Int
  deletedAt  DateTime?
  createdAt  DateTime       @default(now())

  @@index([reportId])
}

model FeedbackEvent {
  id          String         @id @default(cuid())
  reportId    String
  report      FeedbackReport @relation(fields: [reportId], references: [id], onDelete: Cascade)
  actorUserId String?
  action      String         @db.VarChar(40)
  fromState   FeedbackState?
  toState     FeedbackState?
  // Never report text.
  reason      String?        @db.VarChar(500)
  createdAt   DateTime       @default(now())

  @@index([reportId, createdAt])
}

enum FeedbackKind {
  BUG
  IMPROVEMENT
}

enum FeedbackAiReview {
  HUMAN_ONLY
  ALLOWED
  WITHDRAWN
}

enum FeedbackVisibility {
  REPORTER
  INTERNAL
}

enum FeedbackState {
  SUBMITTED
  TRIAGED
  NEEDS_INFORMATION
  ACCEPTED
  IN_PROGRESS
  AWAITING_VERIFICATION
  RESOLVED
  DUPLICATE
  DECLINED
  CLOSED
}

// OPS-5: a card or bank dispute raised through Stripe. One row per Stripe dispute; the webhook only records and flags,
// it never moves money. Chris decides what to send, and sends it once.
enum DisputeState {
  NEEDS_RESPONSE
  UNDER_REVIEW
  WON
  LOST
  CLOSED
}

model PaymentDispute {
  id               String       @id @default(cuid())
  stripeDisputeId  String       @unique
  stripeChargeId   String?
  stripePaymentIntentId String?
  paymentId        String?
  payment          Payment?     @relation(fields: [paymentId], references: [id], onDelete: Restrict)
  invoiceId        String?
  invoice          Invoice?     @relation(fields: [invoiceId], references: [id], onDelete: Restrict)
  customerId       String?
  customer         Customer?    @relation(fields: [customerId], references: [id], onDelete: Restrict)
  amountCents      Int
  reason           String
  stripeStatus     String
  state            DisputeState @default(NEEDS_RESPONSE)
  // A bank (ACH) debit dispute is final: it cannot be contested.
  isBank           Boolean      @default(false)
  dueBy            DateTime?
  outcome          String?
  openedAt         DateTime
  closedAt         DateTime?
  // The newest Stripe event applied, so an older event arriving late never undoes a newer one.
  lastEventAt      DateTime
  lastEventId      String
  evidenceSubmittedAt DateTime?
  evidenceSubmittedByUserId String?
  evidenceFileId   String?
  evidencePacketBytes Int?
  evidenceSummary  Json?
  // The To do for "collect directly" after a bank dispute, once Chris says it is handled.
  handledAt        DateTime?
  handledByUserId  String?
  handledNote      String?
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  @@index([state])
  @@index([customerId])
  @@index([invoiceId])
  @@index([paymentId])
}

// ---------------------------------------------------------------------------
// OPS-1 (docs/build-specs/engines/OWNER-OPERATIONS.md): product recalls.
// The nightly check only ever creates POSSIBLE matches. Only Chris confirms one (CONFIRMED puts the machine on hold).
// REMEDIED is the one state beyond the spec: without it a hold could never end after the maker's fix is done.
// ---------------------------------------------------------------------------
enum RecallMatchState {
  POSSIBLE
  CONFIRMED
  NOT_OURS
  REMEDIED
}

model RecallMatch {
  id           String           @id @default(cuid())
  recallId     String
  recallNumber String
  title        String
  url          String
  hazard       String?
  remedy       String?
  publishedAt  DateTime?
  applianceId  String
  appliance    Appliance        @relation(fields: [applianceId], references: [id], onDelete: Restrict)
  matchReason  String
  state        RecallMatchState @default(POSSIBLE)
  decidedByUserId String?
  decidedAt    DateTime?
  decisionNote String?
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  @@unique([recallId, applianceId])
  @@index([state])
  @@index([applianceId])
}

// One row: when the nightly recall check last finished, and whether Chris asked for a whole-fleet check.
model RecallWatchState {
  id                    String    @id @default("singleton")
  lastSuccessAt         DateTime?
  fullFleetRequestedAt  DateTime?
  fullFleetCheckedAt    DateTime?
  fullFleetCursor       Int       @default(0)
  lastError             String?
  updatedAt             DateTime  @updatedAt
}

enum SafetyIncidentDecision {
  PENDING
  REPORTED
  NOT_REPORTED
}

// An injury or safety incident Chris marked on a repair request or visit. Stays on his To do until he decides about CPSC.
model SafetyIncident {
  id          String   @id @default(cuid())
  applianceId String?
  appliance   Appliance? @relation(fields: [applianceId], references: [id], onDelete: SetNull)
  maintenanceRequestId String?
  jobId       String?
  description String
  markedByUserId String
  decision    SafetyIncidentDecision @default(PENDING)
  decidedByUserId String?
  decidedAt   DateTime?
  decisionNote String?
  createdAt   DateTime @default(now())

  @@index([decision])
  @@index([applianceId])
  @@index([maintenanceRequestId])
  @@index([jobId])
}

// OPS-3: the delivery vehicle(s), the mileage log, and the rules that follow from the vehicle's weight (GVWR).
enum MileageMethod {
  STANDARD_RATE
  ACTUAL_COSTS
}

enum MileageTripSource {
  ROUTE
  MANUAL
}

model FleetVehicle {
  id                    String   @id @default(cuid())
  nickname              String
  year                  Int
  make                  String
  model                 String
  vin                   String?
  plate                 String?
  /// Gross vehicle weight rating in pounds. Required: the license and commercial-vehicle rules depend on it.
  gvwrLbs               Int
  /// 1-12: the month the registration is due each year.
  registrationMonth     Int?
  odometerAtPurchase    Int      @default(0)
  maintenanceEveryMiles Int?
  maintenanceEveryMonths Int?
  lastMaintenanceOn     DateTime?
  lastMaintenanceMiles  Int?
  medicalCardExpiresOn  DateTime?
  notes                 String?
  archivedAt            DateTime?
  createdByUserId       String
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
  trips                 MileageTrip[]
}

model MileageTrip {
  id              String            @id @default(cuid())
  vehicleId       String
  vehicle         FleetVehicle      @relation(fields: [vehicleId], references: [id], onDelete: Restrict)
  /// The business day (Denver midnight).
  tripDate        DateTime
  startOdometer   Int
  /// Null while the day is still in progress.
  endOdometer     Int?
  miles           Int?
  purpose         String
  source          MileageTripSource
  stops           Int               @default(0)
  notes           String?
  createdByUserId String
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  @@index([vehicleId, tripDate])
}

// OPS-6: the past-due ladder. One row per bill per step, made by the nightly pass; nothing reaches a customer until
// the owner or an admin approves it.
enum CollectionStepKind {
  SECOND_NOTICE
  FINAL_NOTICE
  DECISION
  SMALL_CLAIMS
}

enum CollectionStepState {
  WAITING
  SENT
  SKIPPED
  DONE
}

model CollectionStep {
  id            String @id @default(cuid())
  invoiceId     String
  invoice       Invoice @relation(fields: [invoiceId], references: [id], onDelete: Restrict)
  customerId    String
  customer      Customer @relation(fields: [customerId], references: [id], onDelete: Restrict)
  kind          CollectionStepKind
  state         CollectionStepState @default(WAITING)
  // The day (Denver) the step came up, and the amount owed when it did.
  cameUpOn      DateTime
  amountOwedCents Int
  subject       String?
  body          String?
  decidedAt     DateTime?
  decidedByUserId String?
  deliveryId    String?
  // What the owner chose or wrote: the DECISION choice, or why a notice was skipped.
  note          String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@unique([invoiceId, kind])
  @@index([state, kind])
  @@index([customerId])
}

// OPS-6: one per rental that fell behind. Holds the pickup consent, the active-duty court order, the objection and
// the small-claims decision, so each of those is a dated record rather than a note.
model CollectionCase {
  id            String @id @default(cuid())
  agreementId   String @unique
  agreement     RentalAgreement @relation(fields: [agreementId], references: [id], onDelete: Restrict)
  customerId    String
  customer      Customer @relation(fields: [customerId], references: [id], onDelete: Restrict)
  openedAt      DateTime @default(now())
  pickupConsentAt DateTime?
  pickupConsentHow String?
  pickupConsentByUserId String?
  courtOrderOn  DateTime?
  courtOrderNote String?
  pickupJobId   String?
  objectedAt    DateTime?
  objectedNote  String?
  resolvedAt    DateTime?
  resolvedNote  String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([resolvedAt])
}

// OPS-6: a small-claims case the owner says he filed. Only used to count the court's limits (2 a month, 18 a year per county).
model SmallClaimsFiling {
  id            String @id @default(cuid())
  county        String
  filedOn       DateTime
  amountCents   Int
  feeCents      Int
  agreementId   String?
  recordedByUserId String
  note          String?
  createdAt     DateTime @default(now())

  @@index([county, filedOn])
}

enum RefrigerantOutcome {
  RECOVERED
  LEAKED_BEFORE
}

// OPS-2: what happened to the refrigerant in a retired appliance before it was scrapped or thrown away (40 CFR 82.155:
// the scrap yard must get a signed statement). Kept for the rule-book number of years (records.refrigerant_keep_years).
model RefrigerantRecord {
  applianceId      String   @id
  appliance        Appliance @relation(fields: [applianceId], references: [id], onDelete: Restrict)
  refrigerantType  String
  outcome          RefrigerantOutcome
  recoveredByName  String
  recoveredByAddress String
  certificationNumber String?
  equipmentUsed    String?
  recoveredOn      DateTime
  recyclerName     String?
  receiptReference String?
  statementSignedAt DateTime
  statementSignedByUserId String
  // What the statement said when it was signed. Reprints use these, so later edits to a name or appliance never change a signed statement.
  signedByName     String
  assetNumberSnapshot String
  applianceDescriptionSnapshot String
  serialNumberSnapshot String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@index([recoveredOn])
}
