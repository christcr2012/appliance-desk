  customer         Customer      @relation(fields: [customerId], references: [id])
  source           ReceiptSource
  amountCents      Int
  method           String
  stripeChargeId   String?       @unique
  receivedOn       DateTime
  recordedByUserId String?
  notes            String?
  payments         Payment[]
  fundedDeposit    Deposit?
  signingPaymentObligation AgreementSigningPayment?
  signingDownPaymentCredit SigningDownPaymentCredit?
  createdAt        DateTime      @default(now())

  @@index([customerId, receivedOn])
}

model CreditApplication {
  id              String         @id @default(cuid())
  creditId        String
  credit          CustomerCredit @relation(fields: [creditId], references: [id])
  invoiceId       String
  invoice         Invoice        @relation(fields: [invoiceId], references: [id])
  amountCents     Int
  appliedByUserId String?
  createdAt       DateTime       @default(now())

  @@index([creditId])
  @@index([invoiceId])
}

model Invoice {
  collectionSteps CollectionStep[]
  paymentDisputes PaymentDispute[]
  rdfShopRecords RetailDeliveryFeeRecord[] @relation("RdfShopInvoice")
  id          String        @id @default(cuid())
  invoiceNumber Int         @unique @default(autoincrement())
  customerId  String
  customer    Customer      @relation(fields: [customerId], references: [id])
  agreementId String?
  agreement   RentalAgreement? @relation(fields: [agreementId], references: [id])

  status      InvoiceStatus @default(DRAFT)
  version     Int           @default(1)

  billingPeriodStart DateTime?
  billingPeriodEnd   DateTime?

  subtotalCents   Int @default(0)
  discountCents   Int @default(0)
  taxCents        Int @default(0)
  lateFeeCents    Int @default(0)
  amountDueCents  Int
  amountPaidCents Int @default(0)
  dueDate         DateTime?

  cancelledAt      DateTime?
  writtenOffAt     DateTime?
  writtenOffReason String?

  stripeInvoiceId    String? @unique
  // Batch M: a shop sale is a local invoice. saleKind is "SHOP_SALE"; saleLocation is "PICKUP" or "DELIVERED"
  // (decides which address the tax is figured for); saleOperationKey makes a retried sale return the first result.
  saleKind             String?
  saleLocation         String?
  saleServiceAddressId String?
  walkInName           String?
  saleOperationKey     String? @unique
  // TFA-2: a replacement sale (an exchange) points at the sale it replaces, so
  // the delivery fee is never charged twice for one purchase.
  replacementOfInvoiceId String?
  // Stripe: finalized_at from the signed provider invoice, never webhook-receipt time.
  // Local: issue time is its original creation time. Null means evidence is incomplete.
  issuedAt           DateTime?
  lineItems           InvoiceLineItem[]
  retiredSaleDispositions RetiredSaleDisposition[]
  taxLines            InvoiceTaxLine[]
  payments            Payment[]
  refunds             Refund[]
  creditApplications  CreditApplication[]
  // BILL-1: bank payments the bank is still confirming for this bill (see BankPaymentInFlight).
  bankPaymentsInFlight BankPaymentInFlight[]
  // FEE-1: the "your payment is late" warning, the date a late fee may first be recorded, and Chris's phone-call record.
  lateNoticeDeliveryId String?
  lateNoticeCount      Int       @default(0)
  lateFeeDate          DateTime?
  lateFeeToldOn        DateTime?
  lateFeeToldByUserId  String?
  pendingChargesFor     PendingCharge[] @relation("PendingChargeFor")
  pendingChargesApplied PendingCharge[] @relation("PendingChargeApplied")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([customerId])
  @@index([agreementId])
  @@index([issuedAt])
  // Owner billing lists sort newest first with stable ID tie-breaker.
  // Without this compound order index, 5k invoices need a heap scan + sort.
  @@index([createdAt(sort: Desc), id(sort: Desc)], map: "Invoice_createdAt_id_idx")
}

/// BILL-1: "the bank is confirming a payment of $X for this bill". It is only a flag: it never counts as money received
/// and changes no total, book entry or receipt. One row per Stripe PaymentIntent, ever (a retried bank payment reopens it).
model BankPaymentInFlight {
  id                String    @id @default(cuid())
  /// Null until the local bill exists (the first attempt of a rental-subscription bill is mirrored only when paid or failed).
  invoiceId         String?
  invoice           Invoice?  @relation(fields: [invoiceId], references: [id])
  stripeInvoiceId   String?
  agreementId       String?
  agreement         RentalAgreement? @relation(fields: [agreementId], references: [id])
  /// "STRIPE_INVOICE" | "LOCAL_CHECKOUT"
  source            String
  paymentIntentId   String    @unique
  amountCents       Int
  /// "ach" (or the Stripe payment type when it is not us_bank_account)
  method            String
  startedAt         DateTime
  clearedAt         DateTime?
  /// "SUCCEEDED" | "FAILED" | "CANCELED" | "INVOICE_CLOSED"
  clearedReason     String?
  /// Stripe `event.created` of the event that cleared it (orders later events).
  clearedByEventAt  DateTime?
  attempt           Int       @default(1)
  lastCheckedAt     DateTime?
  /// Stripe says it succeeded but the app could not record it yet.
  settledInStripeAt DateTime?
  createdAt         DateTime  @default(now())

  @@index([invoiceId, clearedAt])
  @@index([clearedAt, startedAt])
  @@index([clearedAt, lastCheckedAt])
  @@index([stripeInvoiceId])
}

enum LateFeeClass {
  CONSUMER_LEASE
  CONSUMER_SHORT
  BUSINESS
}

enum PendingChargeKind {
  LATE_FEE
}

// FEE-1: a late fee is its own charge, never added to the overdue bill. One per overdue bill (unique), put on the
// customer's next bill (or its own bill when the rental ended). Waivable before or after it is billed.
model PendingCharge {
  id                String            @id @default(cuid())
  customerId        String
  customer          Customer          @relation(fields: [customerId], references: [id])
  agreementId       String
  agreement         RentalAgreement   @relation(fields: [agreementId], references: [id])
  kind              PendingChargeKind @default(LATE_FEE)
  amountCents       Int
  forInvoiceId      String
  forInvoice        Invoice           @relation("PendingChargeFor", fields: [forInvoiceId], references: [id])
  noticeDeliveryId  String?
  addedOn           DateTime          @default(now())
  appliedToInvoiceId String?
  appliedToInvoice  Invoice?          @relation("PendingChargeApplied", fields: [appliedToInvoiceId], references: [id])
  // Set once the fee is on its way to Stripe (a provider operation), so a retry never posts it twice.
  providerOperationId String?
  // Autopay: the delivered notice of the higher automatic charge, when it was sent, and the charge date it named.
  autopayNoticeDeliveryId String?
  autopayNoticedAt  DateTime?
  autopayChargeOn   DateTime?
  waivedAt          DateTime?
  waivedReason      String?
  waivedByUserId    String?
  createdAt         DateTime          @default(now())

  @@unique([forInvoiceId, kind])
  @@index([appliedToInvoiceId])
  @@index([customerId, appliedToInvoiceId, waivedAt])
}

model InvoiceLineItem {
  rdfRecord RetailDeliveryFeeRecord? @relation("RdfInvoiceLine")
  id          String   @id @default(cuid())
  invoiceId   String
  invoice     Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  kind        InvoiceLineItemKind
  description String
  // Negative for a discount, credit, or downward adjustment — every
  // other total on the invoice is a plain sum of these.
  amountCents Int
  quantity    Int      @default(1)
  rentalLineId String?
  // Batch M: the part a MERCHANDISE line sold (the stock movement points back to this line).
  partRecordId String?
  // M-2C: the retired appliance a USED_APPLIANCE line sold (at most one live sale per appliance, enforced under a lock).
  applianceId String?
  appliance Appliance? @relation("ApplianceSaleLine", fields: [applianceId], references: [id], onDelete: Restrict)

  createdAt DateTime @default(now())

  @@index([invoiceId])
  @@index([applianceId])
}

model Payment {
  disputes PaymentDispute[]
  id          String   @id @default(cuid())
  invoiceId   String
  invoice     Invoice  @relation(fields: [invoiceId], references: [id])
  amountCents Int
  method      String?
  status      String
  attemptNumber Int    @default(1)
  stripeChargeId String?
  stripePaymentIntentId String?
  failureReason String?
  notes String?
  recordedByUserId String?

  // Batch B D6: one real-world payment event can allocate to many invoices.
  // Nullable for pre-Batch-B rows until WU-B5's idempotent backfill links them.
  receiptId String?
  receipt   Receipt? @relation(fields: [receiptId], references: [id])

  createdAt DateTime @default(now())

  @@index([invoiceId])
  @@index([receiptId])
}

enum RefundReason {
  OVERPAYMENT
  BILLING_ERROR
  GOODWILL
  DISPUTE_RESOLUTION
  OTHER
}

model Refund {
