  amountCents Int
  occurredOn DateTime
  fromLedgerAccountId String?
  fromLedgerAccount LedgerAccount? @relation("CashEventFrom", fields: [fromLedgerAccountId], references: [id], onDelete: Restrict)
  toLedgerAccountId String?
  toLedgerAccount LedgerAccount? @relation("CashEventTo", fields: [toLedgerAccountId], references: [id], onDelete: Restrict)
