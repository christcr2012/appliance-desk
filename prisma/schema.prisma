  callSessionId String
  session CallSession @relation(fields:[callSessionId],references:[id],onDelete:Restrict)
  kind CommunicationMediaKind
  providerResourceId String
  privateStorageKey String?
  contentHash String?
  durationSeconds Int?
  state CommunicationMediaState @default(PENDING)
  accessPolicyVersion Int @default(1)
  retentionUntil DateTime?
  legalHold Boolean @default(false)
  deletedAt DateTime?
  createdAt DateTime @default(now())
  @@unique([callSessionId,kind,providerResourceId])
  @@index([state,createdAt])
}


// COM-L10 — durable, account-scoped telecom cost evidence only; no live provider actions.
enum TelecomSyncResource {
  MESSAGES
  CALLS
  USAGE
  PRICING
  READINESS
}

enum TelecomCostClassification {
  ESTIMATED
  PROVIDER_REPORTED
  INVOICE_RECONCILED
}

enum TelecomRateSource {
  PRICING_API
  OWNER_VERIFIED
}

enum TelecomStatementState {
  DRAFT
  VERIFIED
  SUPERSEDED
}

model TelecomSyncCursor {
  id String @id @default(cuid())
  accountId String
  account TelecomAccount @relation(fields:[accountId],references:[id],onDelete:Restrict)
  resource TelecomSyncResource
  nextPageToken String?
  windowStart DateTime
  windowEnd DateTime
  completedThrough DateTime?
  claimToken String?
  claimUntil DateTime?
  lastSuccessAt DateTime?
  lastFailureAt DateTime?
  lastErrorCode String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@unique([accountId,resource])
  @@index([claimUntil])
}

model TelecomUsageSnapshot {
  id String @id @default(cuid())
  accountId String
  account TelecomAccount @relation(fields:[accountId],references:[id],onDelete:Restrict)
  category String
  startDate DateTime @db.Date
  endDate DateTime @db.Date
  count Decimal @db.Decimal(24,10)
  countUnit String
  usage Decimal @db.Decimal(24,10)
  usageUnit String
  price Decimal? @db.Decimal(24,10)
  currency String
  providerAsOf DateTime
  capturedAt DateTime @default(now())
  isTotal Boolean @default(false)
  payloadHash String
  providerSource String
  @@unique([accountId,category,startDate,endDate,providerAsOf,payloadHash])
  @@index([accountId,startDate,endDate])
}

model CommunicationCostFact {
  id String @id @default(cuid())
  accountId String
  account TelecomAccount @relation(fields:[accountId],references:[id],onDelete:Restrict)
  businessNumberId String?
  businessNumber BusinessPhoneNumber? @relation("CommunicationCostBusinessNumber",fields:[businessNumberId],references:[id],onDelete:Restrict)
  messageAttemptId String?
  messageAttempt MessageAttempt? @relation("CommunicationCostMessageAttempt",fields:[messageAttemptId],references:[id],onDelete:Restrict)
  callLegId String?
  callLeg CallLeg? @relation("CommunicationCostCallLeg",fields:[callLegId],references:[id],onDelete:Restrict)
  sourceKey String
  component String
  classification TelecomCostClassification
  amount Decimal @db.Decimal(24,10)
  currency String
  quantity Decimal? @db.Decimal(24,10)
  unit String?
  rateVersionId String?
  rateVersion TelecomRateVersion? @relation(fields:[rateVersionId],references:[id],onDelete:Restrict)
  occurredAt DateTime
  providerAsOf DateTime?
  recordedAt DateTime @default(now())
  supersedesId String? @unique
  supersedes CommunicationCostFact? @relation("TelecomCostSupersession",fields:[supersedesId],references:[id],onDelete:Restrict)
  supersededBy CommunicationCostFact? @relation("TelecomCostSupersession")
  statementId String?
  statement TelecomStatement? @relation(fields:[statementId],references:[id],onDelete:Restrict)
  @@unique([accountId,sourceKey,classification])
  @@index([accountId,occurredAt,classification])
  @@index([businessNumberId])
  @@index([messageAttemptId])
  @@index([callLegId])
  @@index([rateVersionId])
  @@index([statementId])
}

model TelecomRateVersion {
  id String @id @default(cuid())
  accountId String
  account TelecomAccount @relation(fields:[accountId],references:[id],onDelete:Restrict)
  service String
  category String
  destinationCountry String?
  destinationPrefix String?
  destinationKey String
  senderType String
  component String
  rate Decimal @db.Decimal(24,10)
  currency String
  unit String
  source TelecomRateSource
  effectiveFrom DateTime
  effectiveUntil DateTime?
  fetchedAt DateTime
  completeness Json @default("{}")
  costFacts CommunicationCostFact[]
  @@unique([accountId,service,component,destinationKey,effectiveFrom,source])
  @@index([accountId,service,component,effectiveFrom])
}

model TelecomStatement {
  id String @id @default(cuid())
  accountId String
  account TelecomAccount @relation(fields:[accountId],references:[id],onDelete:Restrict)
  externalId String
  periodStart DateTime @db.Date
  periodEnd DateTime @db.Date
  currency String
  invoiceTotalCents Int
  issueDate DateTime @db.Date
  privateEvidenceStorageKey String
  evidenceHash String
  state TelecomStatementState @default(DRAFT)
  revision Int @default(1)
  verifiedByUserId String?
  verifiedBy User? @relation("TelecomStatementVerifier",fields:[verifiedByUserId],references:[id],onDelete:Restrict)
  verifiedAt DateTime?
  paidOn DateTime? @db.Date
  vendorTaxCents Int?
  // COM-N3: the one books Expense this statement became (or was matched to). Unique so a statement is booked once.
  paidFromAccountId String?
  expenseId String? @unique
  expense Expense? @relation(fields:[expenseId],references:[id],onDelete:Restrict)
  createdAt DateTime @default(now())
  costFacts CommunicationCostFact[]
  @@unique([accountId,externalId,revision])
  @@index([accountId,periodStart,periodEnd])
}

// W-1: durable, actor-attributed snoozes for owner To do exceptions.
model ExceptionSnooze {
  key            String   @id @db.VarChar(64)
  category       String   @db.VarChar(80)
  href           String   @db.VarChar(400)
  snoozedUntil   DateTime
  reason         String   @db.VarChar(500)
  actorUserId    String
  actor          User     @relation(fields: [actorUserId], references: [id], onDelete: Restrict)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([snoozedUntil])
}

// W-26 reviewed Spanish copy activation: explicitly separate owner recording of
// actual reviewer evidence from deploy, and invalidate every approval on copy changes.
model CustomerLanguageReview {
  language String @id
  copyDigest String
  reviewerName String
  reviewReference String
  reviewedAt DateTime
  legalReviewerName String?
  legalReviewReference String?
  legalReviewedAt DateTime?
  publishedAt DateTime?
  publishedByUserId String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  events CustomerLanguageReviewEvent[]
}

model CustomerLanguageReviewEvent {
  id String @id @default(cuid())
  language String
  review CustomerLanguageReview @relation(fields: [language], references: [language], onDelete: Restrict)
  actorUserId String
  action String
  reviewedDigest String
  evidenceReference String?
  occurredAt DateTime @default(now())
  @@index([language, occurredAt])
}

// Bilingual draft, never itself a public publication or legal approval.
// The source digest invalidates stale Spanish wording if English is edited.
model CustomerTranslationDraft {
  id String @id @default(cuid())
  sourceKind String
  sourceKey String
  englishDigest String
  spanishText String
  revision Int @default(1)
  editedByUserId String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@unique([sourceKind, sourceKey])
}

// Batch K — accounting domain; immutable journal provenance and bounded account mapping.
enum LedgerAccountType {
  ASSET
  CONTRA_ASSET
  LIABILITY
  EQUITY
  INCOME
  CONTRA_INCOME
  EXPENSE
}

enum JournalSourceType {
  OPENING
  SCRAP_PAYMENT
  INVOICE
  RECEIPT
  PAYMENT
  DEPOSIT
  CUSTOMER_CREDIT
  CREDIT_APPLICATION
  REFUND
  STRIPE_BALANCE_TXN
  EXPENSE
  APPLIANCE
  USE_TAX
  TAX_FILING
  CASH_EVENT
}

enum AccountingPeriodStatus {
  OPEN
  CLOSED
}

enum ExpenseStatus {
  DRAFT
  SUBMITTED
  POSTED
  VOID
}

enum ExportTarget {
  QBO_JOURNAL_CSV
  XERO_JOURNAL_CSV
  GENERIC_JOURNAL_CSV
  CASH_MOVEMENTS_CSV
}

enum ExportMode {
  DAILY_SUMMARY
  DETAIL
}

model LedgerAccount {
  id              String                 @id @default(cuid())
  systemRole      String?                @unique // section 2.1; null for owner-added accounts
  name            String
  type            LedgerAccountType
  description     String // plain words, shown on screen
  isPaymentSource Boolean                @default(false)
  filingAccountId String? // set for per-filing-account tax payable accounts
  active          Boolean                @default(true)
  sortOrder       Int                    @default(0)
  mappings        AccountExportMapping[]
  cashAccount     CashAccount? @relation("CashAccountLedger")
  cashOutEvents   BookCashEvent[] @relation("CashEventFrom")
  cashInEvents    BookCashEvent[] @relation("CashEventTo")
  lines           JournalLine[]
  createdAt       DateTime               @default(now())
  updatedAt       DateTime               @updatedAt
}

model AccountExportMapping {
  id              String        @id @default(cuid())
  ledgerAccountId String
  ledgerAccount   LedgerAccount @relation(fields: [ledgerAccountId], references: [id])
  target          ExportTarget
  externalName    String // QuickBooks account name ("Parent:Child" for sub-accounts) or Xero account code
  externalTaxRate String? // Xero only; starting value "Tax Exempt" — the owner confirms the exact name of the no-tax rate in his Xero organisation

  @@unique([ledgerAccountId, target])
}

model JournalEntry {
  id          String             @id @default(cuid())
  entryNumber Int                @unique @default(autoincrement())
  entryDate   DateTime // Colorado midnight of the business date
  periodKey   String // "YYYY-MM" of entryDate (Colorado)
  sourceType  JournalSourceType
  sourceId    String
  eventKind   String // section 3.2 names
  memo        String
  customerId  String?
  applianceId String?
  lateForDate DateTime?
  lines       JournalLine[]
  exports     ExportBatchEntry[]
  createdAt   DateTime           @default(now())

  @@unique([sourceType, sourceId, eventKind])
  @@index([periodKey])
  @@index([entryDate])
}

model JournalLine {
  budgetSpendSplits BudgetSpendSplit[]
  id              String        @id @default(cuid())
  entryId         String
  entry           JournalEntry  @relation(fields: [entryId], references: [id])
  ledgerAccountId String
  ledgerAccount   LedgerAccount @relation(fields: [ledgerAccountId], references: [id])
  debitCents      Int           @default(0)
  creditCents     Int           @default(0)
  memo            String?
  bankMatchItems  BankMatchItem[]

  @@index([ledgerAccountId])
  @@index([entryId])
}

model AccountingPeriod {
  periodKey      String                 @id
  status         AccountingPeriodStatus @default(OPEN)
  closedAt       DateTime?
  closedByUserId String?
  reopenedReason String?
  reviewNotes Json?
  accountantSentAt DateTime?
  updatedAt      DateTime               @updatedAt
}

model StripeBalanceTransaction {
  id                String   @id // Stripe txn_… id
  type              String
  reportingCategory String
  amountCents       Int
  feeCents          Int
  netCents          Int
  currency          String
  sourceId          String?
  payoutId          String?
  description       String?
  createdAtStripe   DateTime
  availableOn       DateTime
  syncedAt          DateTime @default(now())

  @@index([createdAtStripe])
  @@index([payoutId])
}

model IntegrationCursor {
  key       String   @id // "stripe-balance-transactions"
  value     String
  updatedAt DateTime @updatedAt
}

model ExpenseCategory {
  id              String    @id @default(cuid())
  name            String
  description     String
  ledgerAccountId String
  active          Boolean   @default(true)
  sortOrder       Int       @default(0)
  expenses        Expense[]
  createdAt       DateTime  @default(now())
}

model Expense {
  id                    String          @id @default(cuid())
  status                ExpenseStatus
  spentOn               DateTime
  amountCents           Int // total paid, including any tax the seller charged
  vendorTaxCents        Int             @default(0)
  vendorName            String
  supplierId            String?
  categoryId            String
  category              ExpenseCategory @relation(fields: [categoryId], references: [id])
  paidFromAccountId     String
  memo                  String?
  receiptPhotoId        String?
  noReceiptReason       String?
  applianceId           String?
  jobId                 String?
  purchaseOrderId       String?
  capitalizeToAppliance Boolean         @default(false)
  recurringExpenseId    String?
  submittedByUserId     String
  postedByUserId        String?
  postedAt              DateTime?
  voidedAt              DateTime?
  voidedByUserId        String?
  voidReason            String?
  version               Int             @default(1)
  createdAt             DateTime        @default(now())
  updatedAt             DateTime        @updatedAt
  telecomStatement      TelecomStatement?

  @@index([status, spentOn])
  @@index([applianceId])
  @@index([submittedByUserId])
  @@index([categoryId])
}

model RecurringExpense {
  id                String   @id @default(cuid())
  name              String
  vendorName        String
  amountCents       Int
  categoryId        String
  paidFromAccountId String
  dayOfMonth        Int // 1–28
  active            Boolean  @default(true)
  lastCreatedFor    String? // "YYYY-MM"
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}


model BookAsset {
  applianceId String @id
  appliance Appliance @relation(fields: [applianceId], references: [id], onDelete: Restrict)
  costCents Int
  placedInServiceOn DateTime
  lifeMonths Int
  salvagePercent Int
  lastDepreciationMonth String?
  fullyDepreciatedOn DateTime?
  retiredOn DateTime?
  retirementIntent String?
  retiredValueCents Int?
  // M-2C: the day the retired appliance was sold (its book value left the books then); null while still held.
  disposedOn DateTime?
  disposalCycle Int @default(0)
  enrollmentSource String @default("MANUAL")
  version Int @default(1)
  createdByUserId String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  taxEvidence BookTaxEvidence[]

  @@index([retiredOn])
}

// Unresolved books exceptions are held separately from journals. They can be resolved, never silently forgotten.
model BooksProblem {
  id String @id @default(cuid())
  kind String
  subjectType String
  subjectId String
  message String
  firstSeenAt DateTime @default(now())
  lastSeenAt DateTime @default(now())
  resolvedAt DateTime?

  @@unique([kind, subjectType, subjectId])
  @@index([resolvedAt, kind])
}

// M-2C: what was known about the income-tax side of selling one retired appliance, frozen when the sale was saved.
// Estimates only (never a filing). Rows are never edited except to mark the accountant follow-up done or the sale cancelled.
model RetiredSaleDisposition {
  id String @id @default(cuid())
  applianceId String
  appliance Appliance @relation(fields: [applianceId], references: [id], onDelete: Restrict)
  invoiceId String
  invoice Invoice @relation(fields: [invoiceId], references: [id], onDelete: Restrict)
  saleDate DateTime
  priceCents Int
  sellerCostsCents Int @default(0)
  bookCarriedCents Int
  taxStatus String
  evidenceId String?
  evidenceClassification String?
  evidenceConfidence String?
  adjustedBasisCents Int?
  totalDepreciationCents Int?
  taxGainCents Int?
  potentialRecaptureCents Int?
  otherGainCents Int?
  reviewReasons String[]
  followUpDoneAt DateTime?
  followUpDoneByUserId String?
  cancelledAt DateTime?
  createdByUserId String
  createdAt DateTime @default(now())

  @@unique([invoiceId, applianceId])
  @@index([applianceId])
  @@index([followUpDoneAt, cancelledAt])
}

model BookTaxEvidence {
  id String @id @default(cuid())
  applianceId String
  asset BookAsset @relation(fields: [applianceId], references: [applianceId], onDelete: Restrict)
  classification String
  confidence String
  originalBasisCents Int?
