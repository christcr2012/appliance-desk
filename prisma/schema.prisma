  method           String
  stripeChargeId   String?       @unique
  receivedOn       DateTime
  recordedByUserId String?
  notes            String?
  payments         Payment[]
  fundedDeposit    Deposit?
  createdAt        DateTime      @default(now())

  @@index([customerId, receivedOn])
}

model CreditApplication {
  id              String         @id @default(cuid())
  creditId        String
  credit          CustomerCredit @relation(fields: [creditId], references: [id])
  invoiceId       String
  invoice         Invoice        @relation(fields: [invoiceId], references: [id])
  amountCents     Int
  appliedByUserId String?
  createdAt       DateTime       @default(now())

  @@index([creditId])
  @@index([invoiceId])
}

model Invoice {
  rdfShopRecords RetailDeliveryFeeRecord[] @relation("RdfShopInvoice")
  id          String        @id @default(cuid())
  invoiceNumber Int         @unique @default(autoincrement())
  customerId  String
  customer    Customer      @relation(fields: [customerId], references: [id])
  agreementId String?
  agreement   RentalAgreement? @relation(fields: [agreementId], references: [id])

  status      InvoiceStatus @default(DRAFT)
  version     Int           @default(1)

  billingPeriodStart DateTime?
  billingPeriodEnd   DateTime?

  subtotalCents   Int @default(0)
  discountCents   Int @default(0)
  taxCents        Int @default(0)
  lateFeeCents    Int @default(0)
  amountDueCents  Int
  amountPaidCents Int @default(0)
  dueDate         DateTime?

  cancelledAt      DateTime?
  writtenOffAt     DateTime?
  writtenOffReason String?

  stripeInvoiceId    String? @unique
  // Stripe: finalized_at from the signed provider invoice, never webhook-receipt time.
  // Local: issue time is its original creation time. Null means evidence is incomplete.
  issuedAt           DateTime?
  lineItems           InvoiceLineItem[]
  taxLines            InvoiceTaxLine[]
  payments            Payment[]
  refunds             Refund[]
  creditApplications  CreditApplication[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([customerId])
  @@index([agreementId])
  @@index([issuedAt])
}

model InvoiceLineItem {
  rdfRecord RetailDeliveryFeeRecord? @relation("RdfInvoiceLine")
  id          String   @id @default(cuid())
  invoiceId   String
  invoice     Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  kind        InvoiceLineItemKind
  description String
  // Negative for a discount, credit, or downward adjustment — every
  // other total on the invoice is a plain sum of these.
  amountCents Int
  quantity    Int      @default(1)
  rentalLineId String?

  createdAt DateTime @default(now())

  @@index([invoiceId])
}

model Payment {
  id          String   @id @default(cuid())
  invoiceId   String
  invoice     Invoice  @relation(fields: [invoiceId], references: [id])
  amountCents Int
  method      String?
  status      String
  attemptNumber Int    @default(1)
  stripeChargeId String?
  stripePaymentIntentId String?
  failureReason String?
  notes String?
  recordedByUserId String?

  // Batch B D6: one real-world payment event can allocate to many invoices.
  // Nullable for pre-Batch-B rows until WU-B5's idempotent backfill links them.
  receiptId String?
  receipt   Receipt? @relation(fields: [receiptId], references: [id])

  createdAt DateTime @default(now())

  @@index([invoiceId])
  @@index([receiptId])
}

enum RefundReason {
  OVERPAYMENT
  BILLING_ERROR
  GOODWILL
  DISPUTE_RESOLUTION
  OTHER
}

model Refund {
  id          String       @id @default(cuid())
  invoiceId   String
  invoice     Invoice      @relation(fields: [invoiceId], references: [id])
  amountCents Int
  reason      RefundReason
  notes       String?
  authorizedByUserId String?
  stripeRefundId String?

  createdAt DateTime @default(now())

  @@index([invoiceId])
}

model CustomerCredit {
  id             String   @id @default(cuid())
  customerId     String
  customer       Customer @relation(fields: [customerId], references: [id])
  amountCents    Int
  remainingCents Int
  reason         String
  notes          String?
  authorizedByUserId String?

  // Batch B D3/D4/D7: immutable provenance and provider-delivery state.
  sourceType String?
  sourceId   String?
  side       String?
  appliedViaStripeAt DateTime?
  // Stripe-applied credits from the late-delivery rule are shown on the local
  // mirror of the bill that used them, as their own labeled line
  // (src/domains/billing/webhooks.ts). shownCents is how much has been shown so
  // far (Stripe may use a credit across two bills); shownOnInvoiceId is set
  // once the whole amount has been shown. Local applications use CreditApplication.
  shownCents       Int     @default(0)
  shownOnInvoiceId String?
  applications CreditApplication[]

  createdAt DateTime @default(now())

  @@index([customerId])
  @@unique([sourceType, sourceId, side])
}

// Every Stripe webhook event this app has ever processed, keyed by
// Stripe's own event id — webhook delivery is at-least-once, so Stripe
// (or a retried delivery after a timeout) can send the same event twice.
model WebhookEvent {
  id          String   @id
  type        String
  processedAt DateTime @default(now())
}

