model TaxRateVersion {
  id                  String          @id @default(cuid())
  jurisdictionId      String
  jurisdiction        TaxJurisdiction @relation(fields: [jurisdictionId], references: [id])
  rateMilliPercent    Int
  effectiveFrom       DateTime
  source              TaxRateSource
  sourceNote          String?
  recordedByUserId    String?
  stripeTaxRateId     String?         @unique
  autoApplied         Boolean         @default(false)
  autoAppliedUndoneAt DateTime?
  invoiceTaxLines     InvoiceTaxLine[]
  useTaxRows          PurchaseUseTax[]
  createdAt           DateTime        @default(now())

  @@unique([jurisdictionId, effectiveFrom])
}

model TaxRateObservation {
  id               String          @id @default(cuid())
  jurisdictionId   String
  jurisdiction     TaxJurisdiction @relation(fields: [jurisdictionId], references: [id])
  asOf             DateTime
  rateMilliPercent Int
  observedAt       DateTime        @default(now())

  @@index([jurisdictionId, asOf])
  @@index([observedAt])
}

model OfficialSourceWatch {
  id                  String   @id @default(cuid())
  label               String
  url                 String   @unique
  active              Boolean  @default(true)
  // TFA-3: which strict parser reads this page (RDF_RATES, GREELEY_RATE,
  // IRS_1099_THRESHOLD, CO_INTEREST); null means hash-only watching.
  parserKey           String?
  lastHash            String?
  lastText            String?
  lastExcerpt         String?
  lastCheckedAt       DateTime?
  lastChangedAt       DateTime?
  lastError           String?
  consecutiveFailures Int      @default(0)
  reviewedAt          DateTime?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  ruleObservations LegalRuleObservation[]
}

// TFA-3: one stored reading from a strict parser over an official page
// (same pattern as TaxRateObservation). A reading is never applied on its
// own: the owner approves it on To do (approvedVersionId links the rule
// version it created) or dismisses it (dismissedAt), and a dismissed or
// approved reading never asks again.
model LegalRuleObservation {
  id                String              @id @default(cuid())
  ruleKey           String              @db.VarChar(80)
  value             Json
  effectiveFrom     DateTime?
  watchId           String
  watch             OfficialSourceWatch @relation(fields: [watchId], references: [id])
  evidence          String              @db.VarChar(1000)
  observedAt        DateTime            @default(now())
  dismissedAt       DateTime?
  dismissNote       String?             @db.VarChar(500)
  dismissedByUserId String?
  approvedVersionId String?

  @@index([ruleKey, effectiveFrom])
  @@index([observedAt])
}

model TaxabilityRule {
  id              String           @id @default(cuid())
  jurisdictionId  String?
  jurisdiction    TaxJurisdiction? @relation(fields: [jurisdictionId], references: [id])
  category        TaxChargeCategory
  taxability      Taxability       @default(UNDECIDED)
  reason          String?
  cpaConfirmedOn  DateTime?
  updatedByUserId String?
  updatedAt       DateTime         @updatedAt
  // DEC-1a: a researched starting value that runs before the CPA confirms it ("Starting value — not confirmed").
  provisional        Boolean @default(false)
  provisionalReason  String?
  provisionalSources Json?

  @@unique([jurisdictionId, category])
}

// DEC-1a: append-only history of every taxability cell, so a late bill for an old date is taxed by the rule of its own
// date. The migration copied every rule that existed then with effectiveFrom 1970-01-01. No foreign key on purpose:
// history outlives a tax area that is later removed.
model TaxabilityRuleVersion {
  id              String            @id @default(cuid())
  jurisdictionId  String?
  category        TaxChargeCategory
  taxability      Taxability
  effectiveFrom   DateTime
  provisional     Boolean           @default(false)
  cpaConfirmedOn  DateTime?
  reason          String?
  sources         Json?
  createdByUserId String?
  createdAt       DateTime          @default(now())

  @@index([jurisdictionId, category, effectiveFrom])
}

// TFA-1: every legal number the desk relies on (tax and fee rates, thresholds,
// deadlines) as a dated version with its source. Reads use the version in force
// on the date that matters; nothing is overwritten, so a late change can be
// true-up'd against the version that should have applied. `provisional` is true
// until the value is confirmed (official-watch values from strict parsers are
// false); `autoApplied` records whether an official-watch value went in on its
// own. Owner overrides are versions with origin OWNER and a reason in the audit
// row. `undoneAt` marks a version the owner undid before its start date.
model LegalRuleVersion {
  id            String          @id @default(cuid())
  ruleKey       String          @db.VarChar(80)
  value         Json
  effectiveFrom DateTime
  origin        LegalRuleOrigin
  sourceUrl     String?         @db.VarChar(500)
  sourceQuote   String?         @db.VarChar(1000)
  checkedOn     DateTime?
  provisional   Boolean         @default(true)
  autoApplied   Boolean         @default(false)
  undoneAt      DateTime?
  createdByUserId String?
  createdAt     DateTime        @default(now())

  rdfRecords    RetailDeliveryFeeRecord[] @relation("RdfRuleVersion")

  // No @@unique here: uniqueness is one ACTIVE version per
  // (ruleKey, effectiveFrom, origin), enforced by the SQL-only partial unique
  // index in migration 20261101000000_legal_rules (an undone version stays
  // as history and must not block its replacement). See DATABASE.md.
  @@index([ruleKey, effectiveFrom])
}

// DEC-1a: Decisions & reviews. One append-only row per answer, confirmation, question sent or reopening. The setting
// itself stays where it lives; this is the evidence trail (docs/build-specs/engines/DECISIONS-CENTER.md section 1).
model DecisionRecord {
  id                     String    @id @default(cuid())
  subjectId              String
  kind                   String
  audience               String
  value                  Json?
  previousValue          Json?
  effectiveFrom          DateTime?
  answeredByUserId       String?
  answeredBy             User?     @relation("DecisionAnsweredBy", fields: [answeredByUserId], references: [id], onDelete: SetNull)
  professionalName       String?
  professionalFirm       String?
  professionalAnsweredOn DateTime?
  explanation            String?
  attachmentUrl          String?
  sources                Json?
  via                    String
  createdAt              DateTime  @default(now())

  @@index([subjectId, createdAt])
  @@index([audience, createdAt])
}

// DEC-1a: a decision that starts on a later Colorado date. The nightly scheduled-changes run applies it through the
// subject's own save; tax reads overlay it from its date even before that run.
model DecisionScheduledChange {
  id               String    @id @default(cuid())
  subjectId        String
  value            Json
  effectiveFrom    DateTime
  decisionRecordId String
  provisional      Boolean   @default(false)
  appliedAt        DateTime?
  cancelledAt      DateTime?
  createdAt        DateTime  @default(now())

  @@index([appliedAt, effectiveFrom])
  @@index([subjectId, effectiveFrom])
}

model AddressTaxLocation {
