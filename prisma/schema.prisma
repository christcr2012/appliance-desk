model BusinessSettings {
  // OPS-3: how the owner claims vehicle costs. Starting value: the standard mileage rate in the first year (keeps both options open).
  mileageMethod MileageMethod @default(STANDARD_RATE)
  // OPS-3: a medical card is asked for from this vehicle weight up (starting value: required from 16,001 lb; not confirmed).
  vehicleMedicalCardRequired Boolean @default(true)
  // Batch M-2: remind on Today when a retired appliance has had no plan (or an unfinished one) this many days; 0 = never.
  retiredFollowUpDays Int @default(30)
  // O-5: warn on Today when a ready-to-rent appliance has sat idle this many days (0 = never) and when fleet utilization
  // falls below this percent (null = never).
  idleApplianceAlertDays Int @default(30)
  utilizationAlertPercent Int?
  // O-3: approval limits. {} = nobody needs approval. Keys are approval kinds, values are cents.
  approvalThresholds Json @default("{}")
  approvalExpiryDays Int @default(7)
  // K-CASH-4A: cash budgeting is OFF until source-reviewed owner setup.
  cashBudgetStartOn DateTime?
  cashBudgetEnabled Boolean @default(false)
  bankEvidenceMaxAgeDays Int @default(7)
  budgetPlanningHorizonDays Int @default(90)
  budgetUpcomingWindowDays Int @default(30)
  budgetReminderLeadDays Int @default(7)
