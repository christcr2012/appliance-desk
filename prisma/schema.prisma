model TaxFilingPeriod {
  rdfRecords RetailDeliveryFeeRecord[] @relation("RdfFilingPeriod")
  rdfCredits RetailDeliveryFeeRecord[] @relation("RdfCreditPeriod")
  id                      String               @id @default(cuid())
