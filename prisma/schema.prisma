  @@index([firstJobId])
  @@index([invoiceId])
  @@index([status, deliveredOn])
  @@index([filingPeriodId])
}

enum RdfSwitchKind {
  START
  STOP
}

// TFA-2: one prepared delivery-fee switch. The app prepares and dates it; it
// changes a customer bill only after the owner approves it on Today. A START
// with no approval yet means the fee is owed but not billed to customers.
model RetailDeliveryFeeSwitch {
  id               String        @id @default(cuid())
  kind             RdfSwitchKind
  startsOn         DateTime
  // The prior-year Colorado retail total the Jan 1 test used (null for the
  // new-business start, which is dated from the crossing instead).
  basisRetailCents Int?
  approvedAt       DateTime?
  approvedByUserId String?
  createdAt        DateTime      @default(now())

  @@unique([kind, startsOn])
  @@index([startsOn])
}

// TFA-2 §8: one filing-frequency advice. The monthly job computes the
// trailing-12-month average of state and state-collected tax and compares it
// with the rule-book limits; the app never changes the frequency itself. The
// To do offers a one-tap confirm once Colorado has agreed (Revenue Online),
// and the confirm marks this row and sets the account frequency, which only
// future periods pick up.
model FilingFrequencyAdvice {
  id                  String             @id @default(cuid())
  filingAccountId     String
  filingAccount       TaxFilingAccount   @relation(fields: [filingAccountId], references: [id])
  currentFrequency    TaxFilingFrequency
  advisedFrequency    TaxFilingFrequency
  averageMonthlyCents Int
  computedOn          DateTime           @default(now())
  confirmedAt         DateTime?
  confirmedByUserId   String?

  @@index([filingAccountId, computedOn])
}

model TaxFilingAmendment {
  id                 String             @id @default(cuid())
  periodId           String
  period             TaxFilingPeriod    @relation(fields: [periodId], references: [id])
  sequence           Int
  status             TaxAmendmentStatus @default(OPEN)
  packet             Json
  additionalTaxCents Int
  detectedAt         DateTime           @default(now())
  filedOn            DateTime?
  paidOn             DateTime?
  confirmationNumber String?
  amountPaidCents    Int?
  filedByUserId      String?
  notes              String?
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  @@unique([periodId, sequence])
  @@index([status, detectedAt])
}

enum PurchaseSellerTaxKind {
  COLORADO
  OTHER_STATE
  NONE
  UNKNOWN
}

enum PurchaseDocumentKind {
  RECEIPT
  INVOICE
  OTHER
}

// W-14: one seller, one date, one receipt, many appliances. Money is integer cents. The tax is exactly what
// the receipt printed; the split across machines is stored on each Appliance (acquisitionTaxPaidCents).
// Other charges (delivery etc.) stay here and are never added to a machine's cost or use-tax base.
model Purchase {
  id                String   @id @default(cuid())
  // One random key per "Record a purchase" form: a repeated save returns the first result.
  operationKey      String   @unique
  payloadHash       String
  supplierId        String?
  supplier          Supplier? @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  sellerName        String?
  purchasedOn       DateTime
  reference         String?
  subtotalCents     Int
  sellerTaxCents    Int      @default(0)
  sellerTaxKind     PurchaseSellerTaxKind
  sellerTaxState    String?
  otherChargesCents Int      @default(0)
  notes             String?
  createdByUserId   String
  // Monotonic revision of the tax answer so two people never overwrite each other silently.
  taxRevisionAt     DateTime
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  appliances Appliance[]
  documents  PurchaseDocument[]

  @@index([supplierId])
  @@index([purchasedOn])
}

// A receipt or invoice page. The file itself is a private upload (Photo row, owner/admin only).
model PurchaseDocument {
  id         String               @id @default(cuid())
  purchaseId String
  purchase   Purchase             @relation(fields: [purchaseId], references: [id], onDelete: Cascade)
  photoId    String               @unique
  photo      Photo                @relation(fields: [photoId], references: [id], onDelete: Restrict)
  kind       PurchaseDocumentKind @default(RECEIPT)
  pageOrder  Int
  createdAt  DateTime             @default(now())

  @@unique([purchaseId, pageOrder])
}

model PurchaseUseTax {
  id                  String           @id @default(cuid())
  sourceType          String
  sourceId            String
  purchasedOn         DateTime
  purchaseAmountCents Int
  vendorTaxCents      Int
  jurisdictionId      String
  jurisdiction        TaxJurisdiction  @relation(fields: [jurisdictionId], references: [id])
  rateVersionId       String
  rateVersion         TaxRateVersion    @relation(fields: [rateVersionId], references: [id])
  useTaxDueCents      Int
  status              UseTaxStatus
  filingPeriodId      String?
  filingPeriod        TaxFilingPeriod? @relation(fields: [filingPeriodId], references: [id])
  createdAt           DateTime         @default(now())

  @@unique([sourceType, sourceId, jurisdictionId])
  @@index([filingPeriodId])
  @@index([jurisdictionId])
}

