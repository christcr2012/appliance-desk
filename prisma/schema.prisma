  accountantEmail String?
  depreciationMonthsDefault Int @default(60)
  depreciationSalvagePercent Int @default(0)
  badDebtTaxRecovery String @default("UNDECIDED")
  lemonRepairPercent Int @default(30)
  vendor1099ThresholdCents Int @default(200000)
  exportPayoutLines Json @default("{\"QBO_JOURNAL_CSV\":true,\"XERO_JOURNAL_CSV\":false,\"GENERIC_JOURNAL_CSV\":true,\"CASH_MOVEMENTS_CSV\":true}")
  id    String @id @default("singleton")

  // W-15 (IN-71): keep purchase receipts and tax records this many years after the machine leaves the fleet.
