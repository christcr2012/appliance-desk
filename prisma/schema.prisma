  id String @id @default(cuid())
  contactPointId String
  contactPoint ContactPoint @relation(fields:[contactPointId], references:[id], onDelete:Restrict)
  customerId String?
  customer Customer? @relation(fields:[customerId], references:[id], onDelete:Restrict)
  leadId String?
  lead Lead? @relation(fields:[leadId], references:[id], onDelete:Restrict)
  customerContactId String?
  customerContact CustomerContact? @relation(fields:[customerContactId], references:[id], onDelete:Restrict)
  source ContactBindingSource
  verifiedAt DateTime?
  revokedAt DateTime?
  createdAt DateTime @default(now())
  @@index([customerId])
  @@index([leadId])
  @@index([customerContactId])
  @@index([contactPointId,revokedAt])
}
model MessageAttempt {
  id String @id @default(cuid())
  deliveryId String
  delivery MessageDelivery @relation("DeliveryAttempts",fields:[deliveryId],references:[id],onDelete:Restrict)
  accountId String?
  account TelecomAccount? @relation(fields:[accountId],references:[id],onDelete:Restrict)
  attemptNumber Int
  operationKey String @unique
  state MessageAttemptState @default(PREPARED)
  providerResourceId String?
  requestHash String
  startedAt DateTime @default(now())
  finishedAt DateTime?
  errorCode String?
  nextAttemptAt DateTime?
  costFacts CommunicationCostFact[] @relation("CommunicationCostMessageAttempt")
  currentFor MessageDelivery? @relation("CurrentMessageAttempt")
  @@unique([deliveryId,attemptNumber])
  @@unique([accountId,providerResourceId])
  @@index([state,startedAt])
  @@index([deliveryId])
}

// COM-L3: private, per-user communication timelines; provider dispatch remains disabled.
enum CommunicationThreadResolution {
  UNRESOLVED
  AMBIGUOUS
  RESOLVED
}
enum CommunicationThreadStatus {
  OPEN
  WAITING
  CLOSED
}
enum CommunicationMessageDirection {
  INBOUND
  OUTBOUND
}
enum CommunicationLinkSource {
  EXPLICIT
  WORKFLOW
  STAFF_CONFIRMED
}
enum CommunicationLinkEntityType {
  Customer
  Lead
  ServiceAddress
  RentalAgreement
  Job
  MaintenanceRequest
  Invoice
  Estimate
}

model CommunicationThread {
  id String @id @default(cuid())
  accountId String
  account TelecomAccount @relation(fields:[accountId],references:[id],onDelete:Restrict)
  businessNumberId String
  businessNumber BusinessPhoneNumber @relation(fields:[accountId,businessNumberId],references:[accountId,id],onDelete:Restrict)
  externalContactPointId String
  externalContactPoint ContactPoint @relation(fields:[externalContactPointId],references:[id],onDelete:Restrict)
  customerId String?
  customer Customer? @relation(fields:[customerId],references:[id],onDelete:Restrict)
  leadId String?
  lead Lead? @relation(fields:[leadId],references:[id],onDelete:Restrict)
  resolution CommunicationThreadResolution @default(UNRESOLVED)
  status CommunicationThreadStatus @default(OPEN)
  assignedUserId String?
  assignedUser User? @relation("CommunicationThreadAssignee",fields:[assignedUserId],references:[id],onDelete:Restrict)
  version Int @default(1)
  lastActivityAt DateTime @default(now())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  messages CommunicationMessage[]
  callSessions CallSession[]
  readMarkers CommunicationReadMarker[]
  @@unique([accountId,businessNumberId,externalContactPointId])
  @@unique([accountId,id])
  @@index([status,lastActivityAt,id])
  @@index([assignedUserId])
}

model CommunicationReadMarker {
  id String @id @default(cuid())
  threadId String
  thread CommunicationThread @relation(fields:[threadId],references:[id],onDelete:Restrict)
  userId String
  user User @relation(fields:[userId],references:[id],onDelete:Restrict)
  lastReadOccurredAt DateTime?
  lastReadMessageId String?
  lastReadMessage CommunicationMessage? @relation("CommunicationReadPosition",fields:[threadId,lastReadMessageId],references:[threadId,id],onDelete:Restrict)
  updatedAt DateTime @updatedAt
  @@unique([threadId,userId])
}

model CommunicationMessage {
  id String @id @default(cuid())
  threadId String
  thread CommunicationThread @relation(fields:[accountId,threadId],references:[accountId,id],onDelete:Restrict)
  direction CommunicationMessageDirection
  deliveryId String? @unique
  delivery MessageDelivery? @relation(fields:[deliveryId],references:[id],onDelete:Restrict)
  providerResourceId String?
  accountId String
  account TelecomAccount @relation(fields:[accountId],references:[id],onDelete:Restrict)
  bodyEncrypted String?
  bodyHash String
  occurredAt DateTime
  receivedAt DateTime @default(now())
  actorUserId String?
  actorUser User? @relation("CommunicationMessageActor",fields:[actorUserId],references:[id],onDelete:Restrict)
  consentRecordId String?
  consentRecord ConsentRecord? @relation(fields:[consentRecordId],references:[id],onDelete:Restrict)
  redactedAt DateTime?
  links CommunicationLink[]
  readMarkers CommunicationReadMarker[] @relation("CommunicationReadPosition")
  @@unique([accountId,providerResourceId])
  @@unique([threadId,id])
  @@index([threadId,occurredAt,id])
}

model CommunicationLink {
  id String @id @default(cuid())
  messageId String
  message CommunicationMessage @relation(fields:[messageId],references:[id],onDelete:Restrict)
  entityType CommunicationLinkEntityType
  entityId String
  source CommunicationLinkSource
  createdAt DateTime @default(now())
  actorUserId String?
  actorUser User? @relation("CommunicationLinkActor",fields:[actorUserId],references:[id],onDelete:Restrict)
  @@unique([messageId,entityType,entityId])
  @@index([entityType,entityId])
}

model CommunicationTemplateRevision {
  id String @id @default(cuid())
  key String
  revision Int
  channel MessageChannel
  purpose MessagePurpose
  body String
  subject String?
  triggerKey String?
  variables Json @default("{}")
  policy Json @default("{}")
  isCurrent Boolean @default(false)
  approvedAt DateTime?
  approvedByUserId String?
  approvedBy User? @relation("CommunicationTemplateApprover",fields:[approvedByUserId],references:[id],onDelete:Restrict)
  createdAt DateTime @default(now())
  createdByUserId String?
  createdBy User? @relation("CommunicationTemplateCreator",fields:[createdByUserId],references:[id],onDelete:Restrict)
  deliveries MessageDelivery[]
  @@unique([key,revision])
}


// COM-L7 voice/media: schema only, all provider ingress, calls and recording OFF.
// No provider URLs or public blob access are stored.
enum CallDirection {
  INBOUND
  OUTBOUND
}
enum CallSessionState {
  NEW
  RINGING
  CONNECTED
  ENDED
  FAILED
}
enum CallOutcome {
  ANSWERED
  MISSED
  VOICEMAIL
  DECLINED
  UNKNOWN
}
enum CallLegRole {
  INBOUND
  FORWARD
  STAFF
  CUSTOMER
}
enum CallLegStatus {
  QUEUED
  RINGING
  IN_PROGRESS
  COMPLETED
  BUSY
  NO_ANSWER
  CANCELED
  FAILED
}
enum CommunicationMediaKind {
  VOICEMAIL
  RECORDING
  TRANSCRIPT
}
enum CommunicationMediaState {
  PENDING
  AVAILABLE
  FAILED
  DELETED
}

model CallSession {
  id String @id @default(cuid())
  accountId String
  account TelecomAccount @relation(fields:[accountId],references:[id],onDelete:Restrict)
  businessNumberId String
  businessNumber BusinessPhoneNumber @relation(fields:[accountId,businessNumberId],references:[accountId,id],onDelete:Restrict)
  contactPointId String?
  contactPoint ContactPoint? @relation(fields:[contactPointId],references:[id],onDelete:Restrict)
  threadId String?
  thread CommunicationThread? @relation(fields:[accountId,threadId],references:[accountId,id],onDelete:Restrict)
  direction CallDirection
  providerRootCallId String
  actorUserId String?
  actorUser User? @relation("CallSessionActor",fields:[actorUserId],references:[id],onDelete:Restrict)
  routingPolicyVersion Int @default(0)
  state CallSessionState @default(NEW)
  outcome CallOutcome?
  startedAt DateTime @default(now())
  connectedAt DateTime?
  endedAt DateTime?
  disposition String?
  dispositionNoteEncrypted String?
  version Int @default(1)
  legs CallLeg[]
  media CommunicationMedia[]
  @@unique([accountId,providerRootCallId])
  @@unique([accountId,id])
  @@index([threadId,startedAt,id])
  @@index([outcome,startedAt])
}

model CallLeg {
  id String @id @default(cuid())
  callSessionId String
  accountId String
  account TelecomAccount @relation(fields:[accountId],references:[id],onDelete:Restrict)
  session CallSession @relation(fields:[accountId,callSessionId],references:[accountId,id],onDelete:Restrict)
  providerCallId String
  providerParentCallId String?
  role CallLegRole
  status CallLegStatus @default(QUEUED)
  sequenceNumber Int?
  durationSeconds Int?
  answeredByStaffAt DateTime?
  startedAt DateTime @default(now())
  endedAt DateTime?
  costFacts CommunicationCostFact[] @relation("CommunicationCostCallLeg")
  @@unique([accountId,providerCallId])
  @@index([callSessionId])
}

model CommunicationMedia {
  id String @id @default(cuid())
  callSessionId String
  session CallSession @relation(fields:[callSessionId],references:[id],onDelete:Restrict)
  kind CommunicationMediaKind
  providerResourceId String
  privateStorageKey String?
  contentHash String?
  durationSeconds Int?
  state CommunicationMediaState @default(PENDING)
  accessPolicyVersion Int @default(1)
  retentionUntil DateTime?
  legalHold Boolean @default(false)
  deletedAt DateTime?
  createdAt DateTime @default(now())
  @@unique([callSessionId,kind,providerResourceId])
  @@index([state,createdAt])
}


// COM-L10 — durable, account-scoped telecom cost evidence only; no live provider actions.
enum TelecomSyncResource {
  MESSAGES
  CALLS
  USAGE
  PRICING
  READINESS
}

enum TelecomCostClassification {
  ESTIMATED
  PROVIDER_REPORTED
  INVOICE_RECONCILED
}

enum TelecomRateSource {
  PRICING_API
  OWNER_VERIFIED
}

enum TelecomStatementState {
  DRAFT
  VERIFIED
  SUPERSEDED
}

model TelecomSyncCursor {
  id String @id @default(cuid())
  accountId String
  account TelecomAccount @relation(fields:[accountId],references:[id],onDelete:Restrict)
  resource TelecomSyncResource
  nextPageToken String?
  windowStart DateTime
  windowEnd DateTime
  completedThrough DateTime?
  claimToken String?
  claimUntil DateTime?
  lastSuccessAt DateTime?
  lastFailureAt DateTime?
  lastErrorCode String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@unique([accountId,resource])
  @@index([claimUntil])
}

model TelecomUsageSnapshot {
  id String @id @default(cuid())
  accountId String
  account TelecomAccount @relation(fields:[accountId],references:[id],onDelete:Restrict)
  category String
  startDate DateTime @db.Date
  endDate DateTime @db.Date
  count Decimal @db.Decimal(24,10)
  countUnit String
  usage Decimal @db.Decimal(24,10)
  usageUnit String
  price Decimal? @db.Decimal(24,10)
  currency String
  providerAsOf DateTime
  capturedAt DateTime @default(now())
  isTotal Boolean @default(false)
  payloadHash String
  providerSource String
  @@unique([accountId,category,startDate,endDate,providerAsOf,payloadHash])
  @@index([accountId,startDate,endDate])
}

model CommunicationCostFact {
  id String @id @default(cuid())
  accountId String
  account TelecomAccount @relation(fields:[accountId],references:[id],onDelete:Restrict)
  businessNumberId String?
  businessNumber BusinessPhoneNumber? @relation("CommunicationCostBusinessNumber",fields:[businessNumberId],references:[id],onDelete:Restrict)
  messageAttemptId String?
  messageAttempt MessageAttempt? @relation("CommunicationCostMessageAttempt",fields:[messageAttemptId],references:[id],onDelete:Restrict)
  callLegId String?
  callLeg CallLeg? @relation("CommunicationCostCallLeg",fields:[callLegId],references:[id],onDelete:Restrict)
  sourceKey String
  component String
  classification TelecomCostClassification
  amount Decimal @db.Decimal(24,10)
  currency String
  quantity Decimal? @db.Decimal(24,10)
  unit String?
  rateVersionId String?
  rateVersion TelecomRateVersion? @relation(fields:[rateVersionId],references:[id],onDelete:Restrict)
  occurredAt DateTime
  providerAsOf DateTime?
  recordedAt DateTime @default(now())
  supersedesId String? @unique
  supersedes CommunicationCostFact? @relation("TelecomCostSupersession",fields:[supersedesId],references:[id],onDelete:Restrict)
  supersededBy CommunicationCostFact? @relation("TelecomCostSupersession")
  statementId String?
  statement TelecomStatement? @relation(fields:[statementId],references:[id],onDelete:Restrict)
  @@unique([accountId,sourceKey,classification])
  @@index([accountId,occurredAt,classification])
  @@index([businessNumberId])
  @@index([messageAttemptId])
  @@index([callLegId])
  @@index([rateVersionId])
  @@index([statementId])
}

model TelecomRateVersion {
  id String @id @default(cuid())
  accountId String
  account TelecomAccount @relation(fields:[accountId],references:[id],onDelete:Restrict)
  service String
  category String
  destinationCountry String?
  destinationPrefix String?
  destinationKey String
  senderType String
  component String
  rate Decimal @db.Decimal(24,10)
  currency String
  unit String
  source TelecomRateSource
  effectiveFrom DateTime
  effectiveUntil DateTime?
  fetchedAt DateTime
  completeness Json @default("{}")
  costFacts CommunicationCostFact[]
  @@unique([accountId,service,component,destinationKey,effectiveFrom,source])
  @@index([accountId,service,component,effectiveFrom])
}

model TelecomStatement {
  id String @id @default(cuid())
  accountId String
  account TelecomAccount @relation(fields:[accountId],references:[id],onDelete:Restrict)
  externalId String
  periodStart DateTime @db.Date
  periodEnd DateTime @db.Date
  currency String
  invoiceTotalCents Int
  issueDate DateTime @db.Date
  privateEvidenceStorageKey String
  evidenceHash String
  state TelecomStatementState @default(DRAFT)
  revision Int @default(1)
  verifiedByUserId String?
  verifiedBy User? @relation("TelecomStatementVerifier",fields:[verifiedByUserId],references:[id],onDelete:Restrict)
  verifiedAt DateTime?
  paidOn DateTime? @db.Date
  vendorTaxCents Int?
  createdAt DateTime @default(now())
  costFacts CommunicationCostFact[]
  @@unique([accountId,externalId,revision])
  @@index([accountId,periodStart,periodEnd])
}
