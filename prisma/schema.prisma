  actorUser User? @relation("CallSessionActor",fields:[actorUserId],references:[id],onDelete:Restrict)
  routingPolicyVersion Int @default(0)
  state CallSessionState @default(NEW)
  outcome CallOutcome?
  startedAt DateTime @default(now())
  connectedAt DateTime?
  endedAt DateTime?
  disposition String?
  dispositionNoteEncrypted String?
  version Int @default(1)
  legs CallLeg[]
  media CommunicationMedia[]
  @@unique([accountId,providerRootCallId])
  @@unique([accountId,id])
  @@index([threadId,startedAt,id])
  @@index([outcome,startedAt])
}

model CallLeg {
  id String @id @default(cuid())
  callSessionId String
  accountId String
  account TelecomAccount @relation(fields:[accountId],references:[id],onDelete:Restrict)
