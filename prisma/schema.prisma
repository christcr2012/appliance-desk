enum TaskPriority {
  LOW
  NORMAL
  HIGH
}

model StaffTask {
  id              String @id @default(cuid())
  note            String
  dueDate         DateTime?
  priority        TaskPriority @default(NORMAL)
  version         Int @default(1)
  assigneeUserId  String?
  assignee        User? @relation("StaffTaskAssignedTo", fields: [assigneeUserId], references: [id], onDelete: SetNull)
  leadId          String?
  lead            Lead? @relation(fields: [leadId], references: [id], onDelete: SetNull)
  customerId      String?
  customer        Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)
  jobId           String?
  job             Job? @relation(fields: [jobId], references: [id], onDelete: SetNull)
  applianceId     String?
  appliance       Appliance? @relation(fields: [applianceId], references: [id], onDelete: SetNull)
  sourceKey       String? @unique
  createdByUserId String
  createdBy       User @relation("StaffTaskCreatedBy", fields: [createdByUserId], references: [id])
  completedAt     DateTime?
  createdAt       DateTime @default(now())

  @@index([completedAt, dueDate])
  @@index([assigneeUserId, completedAt])
  @@index([leadId])
  @@index([customerId])
  @@index([jobId])
  @@index([applianceId])
}

