// ---------------------------------------------------------------------------
// Estimates (2026-09-29, docs/DECISIONS.md has the full writeup) — for
// deals that don't fit standard self-serve pricing: a property manager
// or landlord ordering for several units/an entire building, where
// delivery/installation fees and per-unit pricing need to be worked out
// by hand rather than applied automatically. Deliberately staff-created
// only (Chris/ADMIN, from an existing Customer) — never auto-generated
// from a Lead's answers, so a "property manager" checkbox alone never
// silently changes anyone's price.
//
// An Estimate is a pricing PROPOSAL, not yet a commitment — it never
// reserves real inventory. Once APPROVED, converting it
// (src/domains/estimates's convertEstimateToAgreements) creates one or
// more DRAFT RentalAgreement(s) using its line items as a starting
// point; Chris still adds real RentalLine(s) with actual physical
// appliances the same way he already does for any agreement (see
// src/domains/agreements's addRentalLine) — this only sets up the
// paperwork shell with the agreed pricing/terms, it never bypasses the
// existing appliance-reservation safeguards.
//
// The public approval link reuses the exact same pattern as
// SignatureRecord/the /sign/[id] page below: the record's own
// unguessable cuid `id` IS the link (no separate token field), gated by
// possession of that link, not a login.
// ---------------------------------------------------------------------------

enum EstimateStatus {
  DRAFT
  SENT
  VIEWED
  APPROVED
  CHANGES_REQUESTED
  DECLINED
  EXPIRED
  CONVERTED
}

model Estimate {
  id             String         @id @default(cuid())
  // Sequential, human-facing number (what shows on the document) —
  // separate from `id`, same pattern as Invoice.invoiceNumber.
  estimateNumber Int            @unique @default(autoincrement())
  // Exactly one of customerId/leadId is set when this estimate is
  // created (see src/domains/estimates — createEstimateDraft requires
  // an existing customer; createEstimateDraftForNewLead creates a Lead
  // first and sets leadId instead, for someone who isn't a customer
  // yet). If it started from a lead, customerId gets filled in the
  // moment the customer actually approves it online (approveEstimate
  // converts the lead to a real customer right then — see that
  // function's comment for why approval, not sending or delivery, is
  // the trigger) — leadId stays set afterward too, purely as a
  // trace-back ("this customer started as a lead on this estimate").
  customerId     String?
  customer       Customer?      @relation(fields: [customerId], references: [id])
  leadId         String?
  lead           Lead?          @relation(fields: [leadId], references: [id])
  status         EstimateStatus @default(DRAFT)

  // Internal reference only, e.g. "Sunset Apartments — 12 units" — never
  // shown to the customer (the document just says "Estimate #123").
  title         String
  // Shown to the customer, on the estimate document itself.
  clientMessage String?
  // Never shown to the customer.
  internalNotes String?

  depositCents Int       @default(0)
  // Set the moment Stripe confirms this estimate's own deposit checkout
  // (2026-09-29 — see src/domains/billing/checkout.ts's
  // createDepositCheckoutSessionForEstimate and docs/ROADMAP.md's "A
  // deposit collected at the moment a quote/estimate is approved"
  // entry). Null means either there's no deposit on this estimate
  // (depositCents is 0) or one is required but hasn't been paid yet —
  // the public estimate page tells those two apart itself. Recorded
  // only by the Stripe webhook, same rule as every other "paid" fact in
  // this app (src/domains/billing/webhooks.ts) — approving an estimate
  // never marks this by itself.
  depositPaidAt DateTime?
  // Set once a "you still haven't responded" follow-up email has gone
  // out for the estimate's *current* sentAt (2026-09-29 — see
  // sendEstimateFollowUpReminders in src/domains/estimates and
  // docs/ROADMAP.md's matching entry). Compared for equality against
  // sentAt itself, same pattern as
  // RentalAgreement.billingReminderSentForDate: if Chris revises and
  // re-sends this estimate (a new sentAt), the old value no longer
  // matches, so a fresh follow-up cycle can fire for the re-sent one
  // without a manual reset.
  followUpSentForSentAt DateTime?
  validUntil   DateTime?

  sentAt                  DateTime?
  viewedAt                DateTime?
  respondedAt             DateTime?
  // Whoever actually clicked "approve" on the public link — a real,
  // timestamped record of who said yes, same spirit as
  // SignatureRecord.signerName/signerEmail below, not just "someone with
  // the link approved it."
  approverName            String?
  approverEmail           String?
  approverIpAddress       String?
  changesRequestedMessage String?
  declineReason           String?
  convertedAt             DateTime?

  // The OWNER/ADMIN who created this — every Estimate is staff-created,
  // never self-service.
  createdByUserId String

  lineItems         EstimateLineItem[]
  // Agreement(s) created by converting this estimate (a converted
  // estimate can produce more than one — see the "per property" mode
  // in src/domains/estimates) — so a draft agreement's own page can
  // show "created from Estimate #123" and staff can trace either
  // direction.
  createdAgreements RentalAgreement[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([customerId])
  @@index([leadId])
  @@index([status])
}

model EstimateLineItem {
  id         String   @id @default(cuid())
  estimateId String
  estimate   Estimate @relation(fields: [estimateId], references: [id], onDelete: Cascade)

  // Which property this line belongs to, when the deal already has one
  // on file (e.g. one line per unit at a named property) — null for a
  // line that isn't property-specific (a flat "bulk mobilization fee"
  // covering the whole deal, say). Whether converting this estimate
  // makes ONE combined agreement or one PER distinct property named
  // here is a choice made at conversion time (src/domains/estimates),
  // not stored here — Chris picks per deal, per his own instruction.
  serviceAddressId String?
  serviceAddress   ServiceAddress? @relation(fields: [serviceAddressId], references: [id])

  description String
  quantity    Int    @default(1)
  // Recurring monthly amount for this line (e.g. "3x washer/dryer set
  // @ $50/mo") — 0 if this line is a one-time charge only.
  monthlyPriceCents Int @default(0)
  // One-time charge for this line (e.g. a custom bulk delivery fee) — 0
  // if this line is purely recurring.
  oneTimeFeeCents Int @default(0)

  createdAt DateTime @default(now())

  @@index([estimateId])
}

// ---------------------------------------------------------------------------
// Billing (Phase 6B — see docs/DECISIONS.md's "Phase 6B billing data
// model redesign" entry for the full writeup, and docs/BUSINESS-RULES.md's
// "Billing rules" section for the plain-English billing policy: anniversary
// billing, deposits charged up front, cards + ACH both offered, billing in
// advance).
//
// Nothing reads or writes these models yet as of this redesign — Stripe
// wiring is the next, separate piece of work, once Chris has a real
// Stripe test-mode account. This redesign exists so that work has a data
// model worth building against, instead of retrofitting one under
// pressure once real invoices exist.
// ---------------------------------------------------------------------------

enum InvoiceStatus {
  DRAFT
  OPEN
  PARTIALLY_PAID
  PAID
  FAILED
  VOID
  DELINQUENT
  WRITTEN_OFF
  REFUNDED
}

// One line per invoice, snapshotted at the moment the invoice is created
// and never edited afterward — a historical invoice must never silently
// change because pricing or settings changed later (same immutability
// rule as RentalAgreement's own price snapshot). Correcting a mistake or
// crediting a customer always adds a new line (kind ADJUSTMENT or
// CREDIT), never edits an existing one.
enum InvoiceLineItemKind {
  RENTAL
  DELIVERY_FEE
  INSTALLATION_FEE
  REMOVAL_FEE
  DAMAGE_WAIVER
  DEPOSIT
  TAX
  LATE_FEE
  PREPAY_DISCOUNT
  CREDIT
  ADJUSTMENT
}

model Invoice {
  id          String        @id @default(cuid())
  // Sequential, human-facing invoice number (what a customer sees on a
  // receipt) — separate from `id`, which is only ever an internal key.
  invoiceNumber Int         @unique @default(autoincrement())
  customerId  String
  customer    Customer      @relation(fields: [customerId], references: [id])
  agreementId String?
  agreement   RentalAgreement? @relation(fields: [agreementId], references: [id])

  status      InvoiceStatus @default(DRAFT)

  // The rental period this invoice actually covers — billing is always
  // in advance (docs/BUSINESS-RULES.md), so these dates are the month
  // being paid FOR, not the month the invoice was sent in.
  billingPeriodStart DateTime?
  billingPeriodEnd   DateTime?

  // Rolled-up totals, computed from this invoice's own lineItems at
  // creation time and never recalculated later — the lineItems are the
  // real source of truth; these are a convenient, immutable summary of
  // them (docs/DATABASE.md).
  subtotalCents   Int @default(0)
  discountCents   Int @default(0)
  taxCents        Int @default(0)
  lateFeeCents    Int @default(0)
  amountDueCents  Int
  amountPaidCents Int @default(0)
  dueDate     DateTime?

  cancelledAt     DateTime?
  writtenOffAt    DateTime?
  writtenOffReason String?

  stripeInvoiceId String? @unique
  lineItems   InvoiceLineItem[]
  payments    Payment[]
  refunds     Refund[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([customerId])
  @@index([agreementId])
}

model InvoiceLineItem {
  id          String   @id @default(cuid())
  invoiceId   String
  invoice     Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  kind        InvoiceLineItemKind
  description String
  // Negative for a discount, credit, or downward adjustment — every
  // other total on the invoice is a plain sum of these.
  amountCents Int
  quantity    Int      @default(1)

  // Optional traceability back to the specific rental line this charge
  // came from — never used to recompute the amount, only to answer "why
  // is this line on the invoice."
  rentalLineId String?

  createdAt DateTime @default(now())

  @@index([invoiceId])
}

model Payment {
  id          String   @id @default(cuid())
  invoiceId   String
  invoice     Invoice  @relation(fields: [invoiceId], references: [id])
  amountCents Int
  method      String?  // card | ach
  // succeeded | failed | pending | ach_pending (ACH takes a few business
  // days to clear — this state means Stripe accepted the attempt but it
  // hasn't posted yet, distinct from a card charge's near-instant result)
  status      String
  attemptNumber Int    @default(1)
  stripeChargeId String?
  stripePaymentIntentId String?
  failureReason String?

  // A payment Chris recorded by hand (a check, cash, or a bank transfer
  // he confirmed himself) rather than one Stripe reported through a
  // webhook — see src/domains/billing/manual-payments.ts. Both null on
  // every Stripe-sourced Payment (the only kind that existed before
  // this); recordedByUserId being set is what distinguishes a manual
  // payment from a Stripe one, not the method string (Stripe payments
  // use "card"/"ach"; manual ones use "check"/"cash"/"bank_transfer"/
  // "other").
  notes String?
  recordedByUserId String?

  createdAt DateTime @default(now())

  @@index([invoiceId])
}

enum RefundReason {
  OVERPAYMENT
  BILLING_ERROR
  GOODWILL
  DISPUTE_RESOLUTION
  OTHER
}

// A refund of money already paid on an invoice — separate from a
// security-deposit refund, which stays on Deposit itself
// (Deposit.refundedAt/refundedAmountCents) since that's a different kind
// of money with its own existing record. Every refund here always
// happened after a real payment, so it's always tied to one Invoice.
model Refund {
  id          String       @id @default(cuid())
  invoiceId   String
  invoice     Invoice      @relation(fields: [invoiceId], references: [id])
  amountCents Int
  reason      RefundReason
  notes       String?
  authorizedByUserId String? // the OWNER/ADMIN who approved it — never automatic
  stripeRefundId String?

  createdAt DateTime @default(now())

  @@index([invoiceId])
}

// An account-level credit (e.g. goodwill, or resolving an overpayment)
// that reduces what a customer owes on a FUTURE invoice — deliberately
// separate from Refund (money going back to a payment method) and from
// InvoiceLineItem's CREDIT kind (which is how a credit actually gets
// applied to a specific invoice once it's used).
model CustomerCredit {
  id             String   @id @default(cuid())
  customerId     String
  customer       Customer @relation(fields: [customerId], references: [id])
  amountCents    Int
  remainingCents Int
  reason         String
  notes          String?
  authorizedByUserId String?

  createdAt DateTime @default(now())

  @@index([customerId])
}

// Every Stripe webhook event this app has ever processed, keyed by
// Stripe's own event id — webhook delivery is at-least-once, so Stripe
// (or a retried delivery after a timeout) can send the same event twice.
// Checking this table before acting on an event, and inserting into it
// as part of the same action, is what makes webhook processing
// idempotent (docs/BUSINESS-RULES.md's billing rules).
model WebhookEvent {
  id          String   @id // Stripe's own event id, e.g. "evt_..."
  type        String
  processedAt DateTime @default(now())
}

// ---------------------------------------------------------------------------
// Settings, site content, and everything else Chris edits himself
// ---------------------------------------------------------------------------

model BusinessSettings {
  id    String @id @default("singleton")

  publicBusinessName String @default("[Company Name]")
  publicPhone        String @default("[Phone Number]")
  publicEmail        String @default("[Email Address]")
  publicAddress      String @default("[Business Address]")
  serviceAreaCities  Json   @default("[]")
  serviceAreaZips    Json   @default("[]")
  hours              Json   @default("{}")
  holidayClosures    Json   @default("[]")
  socialLinks        Json   @default("{}")
  logoUrl            String?

  // Delivery and installation are separate, optional one-time fees —
  // Chris may charge for one, both, or neither (e.g. a delivery-only fee
  // when the customer hooks up the appliance themselves). Each shows as
  // its own line item on /pricing. See docs/BUSINESS-RULES.md.
  oneTimeDeliveryFeeCents     Int @default(0)
  oneTimeInstallationFeeCents Int @default(0)
  oneTimeRemovalFeeCents      Int @default(0)
  damageWaiverEnabled     Boolean @default(false)
  depositEnabled          Boolean @default(false)
  lateFeeGraceDays        Int     @default(5)
  lateFeeFlatCents        Int     @default(0)
  lateFeePercent          Int     @default(0)
  taxRatePermille         Int     @default(0) // 0 until a CPA confirms the real rate
  taxRateConfirmed        Boolean @default(false)

  announcementBannerText String?
  announcementBannerOn   Boolean @default(false)

  // Prepaid-term discounts (Chris's explicit request, docs/DECISIONS.md
  // has the dated design decision, docs/BUSINESS-RULES.md's Pricing
  // section has the full rule). Four independent, owner-adjustable dollar
  // amounts — never derived from one another — plus a separate toggle for
  // the "first month free" bonus on a 12-month term paid fully in
  // advance. Defaults match the figures Chris gave as a starting point.
  sixMonthPrepayDiscountSetCents       Int     @default(500)
  sixMonthPrepayDiscountSingleCents    Int     @default(250)
  twelveMonthPrepayDiscountSetCents    Int     @default(1000)
  twelveMonthPrepayDiscountSingleCents Int     @default(500)
  twelveMonthPrepayFreeMonthEnabled    Boolean @default(true)

  // Referral program (Task #68, docs/DECISIONS.md 2026-09-28) — one
  // owner-adjustable dollar amount, applied to BOTH the referrer and
  // the new customer they referred (Chris's explicit pick: "discount
  // for both people," not a one-sided reward). Applied as a Stripe
  // account-balance credit on each side once the referred customer's
  // billing actually starts — see src/domains/referrals.
  referralRewardCents Int @default(2500)

  // Reservation aging (Phase 6A item 6 — see docs/BUSINESS-RULES.md).
  // How many days a DRAFT/AWAITING_SIGNATURE agreement's reserved
  // appliances are held before the desk flags it as stale. Owner-
  // adjustable, same pattern as every other business rule here.
  draftReservationHoldDays Int @default(7)

  // Return-inspection checklist (rental lifecycle, 2026-09-28) — a JSON
  // string array of items Chris ticks off before a returned machine can
  // be rented again. Empty means "use the built-in default list"
  // (DEFAULT_INSPECTION_CHECKLIST in src/domains/inventory/lifecycle.ts).
  inspectionChecklist Json @default("[]")

  updatedAt DateTime @updatedAt
}

model SiteContent {
  id    String @id @default(cuid())
  key   String @unique // "home.headline", "rentals.body", "faq.entry.1", ...
  value String
  updatedAt DateTime @updatedAt
}

model Photo {
  id      String   @id @default(cuid())
  url     String
  altText String?

  applianceId String?
  appliance   Appliance? @relation(fields: [applianceId], references: [id])
  jobId       String?
  job         Job?       @relation(fields: [jobId], references: [id])
  maintenanceRequestId String?
  maintenanceRequest   MaintenanceRequest? @relation(fields: [maintenanceRequestId], references: [id])

  createdAt DateTime @default(now())
}

model ConsentRecord {
  id         String   @id @default(cuid())
  customerId String?
  customer   Customer? @relation(fields: [customerId], references: [id])
  kind       String   // "lead_form_privacy" | "sms_opt_in" | "data_export_request" | "data_deletion_request"
  details    Json?
  createdAt  DateTime @default(now())
}

// Customer workspace (2026-09-28, docs/BUSINESS-RULES.md) — a free-text
// note Chris (or another staff account) leaves on a customer's own
// record: a phone call, something they said, a reminder for next time.
// Deliberately separate from AuditLog, which records what the SYSTEM did
// (status changes, created rows) — a note is something a person chose to
// write down, never generated automatically, and is never edited or
// deleted (an honest record of who said what and when, same reasoning as
// AuditLog itself).
model CustomerNote {
  id         String   @id @default(cuid())
  customerId String
  customer   Customer @relation(fields: [customerId], references: [id])
  authorId   String?
  author     User?    @relation(fields: [authorId], references: [id])
  body       String

  createdAt DateTime @default(now())

  @@index([customerId])
}

// A business/property-manager customer's account is one login (the
// primary contact), but the people Chris actually needs to reach for a
// given property aren't always that same person (a site manager for
// scheduling access, an accounts-payable contact for billing questions).
// Purely informational — never a login, never billed — just numbers and
// names Chris can find on the customer's own page instead of digging
// through old emails or notes.
model CustomerContact {
  id         String   @id @default(cuid())
  customerId String
  customer   Customer @relation(fields: [customerId], references: [id])

  name  String
  role  String? // e.g. "Site manager", "Accounts payable"
  phone String?
  email String?
  notes String?

  createdAt DateTime @default(now())

  @@index([customerId])
}

// A staff member's own follow-up reminder — "call the Oak Street
// property manager back Thursday about renewing" — distinct from the
// system-generated exception flags in src/domains/growth /
// src/domains/exceptions (those are automatically detected from billing/
// job/agreement state; this is something a person chose to jot down for
// themself). Optionally linked to whatever it's about, purely for a
// convenient link back — deleting the linked record never deletes the
// task. See docs/DECISIONS.md's 2026-09-29 CRM-buildout entry.
model StaffTask {
  id      String @id @default(cuid())
  note    String
  dueDate DateTime?

  leadId     String?
  lead       Lead?     @relation(fields: [leadId], references: [id], onDelete: SetNull)
  customerId String?
  customer   Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)
  jobId      String?
  job        Job?      @relation(fields: [jobId], references: [id], onDelete: SetNull)

  createdByUserId String
  createdBy       User   @relation("StaffTaskCreatedBy", fields: [createdByUserId], references: [id])

  completedAt DateTime?

  createdAt DateTime @default(now())

  @@index([completedAt, dueDate])
  @@index([leadId])
  @@index([customerId])
  @@index([jobId])
}

model AuditLog {
  id        String   @id @default(cuid())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id])
  action    String   // e.g. "pricing.update", "lead.convert"
  entityType String
  entityId   String?
  oldValue   Json?
  newValue   Json?
  createdAt  DateTime @default(now())

  @@index([entityType, entityId])
  @@index([createdAt])
}


// Prelaunch interest is not a quote, customer, reservation, or SMS consent.
model LaunchSettings {
  id            String  @id @default("singleton")
  prelaunchMode Boolean @default(true)
  emailEnabled  Boolean @default(false)
  postalAddress String  @default("")
  replyToEmail  String  @default("")
  updatedAt     DateTime @updatedAt
}

model LaunchSubscriber {
  id                String @id @default(cuid())
  name              String
  email             String @unique
  city              String
  interest          String
  source            String @default("website")
  consentVersion    String
  consentText       String
  consentedAt       DateTime @default(now())
  unsubscribeToken  String @unique
  unsubscribedAt    DateTime?
  nextStep          Int @default(0)
  nextSendAt        DateTime @default(now())
  deliveryBlocked   Boolean @default(false)
  createdAt         DateTime @default(now())
  deliveries        LaunchDelivery[]

  @@index([unsubscribedAt, deliveryBlocked, nextSendAt])
}

model LaunchDelivery {
  id           String @id @default(cuid())
  subscriberId String
  subscriber   LaunchSubscriber @relation(fields: [subscriberId], references: [id], onDelete: Cascade)
  step         Int
  // SENDING is an uncertain outcome after a crash; never retried blindly.
  status       String @default("SENDING")
  startedAt    DateTime @default(now())
  finishedAt   DateTime?

  @@unique([subscriberId, step])
}
