# Copy this file to .env.local for local development and fill in real
# values. NEVER commit an actual .env file — secrets live in Vercel's
# environment variables in every deployed environment. See docs/HANDOFF.md.

# --- Database (Neon) ---
# Pooled connection — used by the app for normal queries.
DATABASE_URL="postgresql://user:password@host-pooler.region.aws.neon.tech/appliance_desk?sslmode=require"
# Direct (unpooled) connection — used only for running migrations.
DIRECT_URL="postgresql://user:password@host.region.aws.neon.tech/appliance_desk?sslmode=require"

# --- Auth (Better Auth) ---
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
BETTER_AUTH_SECRET=""
BETTER_AUTH_URL="http://localhost:3000"

NEXT_PUBLIC_APP_URL="http://localhost:3000"

# --- One-time owner account setup (prisma/seed.ts) ---
# OWNER_EMAIL=""
# OWNER_PASSWORD=""

# --- Error monitoring (Sentry) ---
# SENTRY_DSN=""
# NEXT_PUBLIC_SENTRY_DSN=""
# SENTRY_ORG=""
# SENTRY_PROJECT=""
# SENTRY_AUTH_TOKEN=""

# --- Transactional email (Resend — see docs/DECISIONS.md) ---
# Without RESEND_API_KEY set, new-lead notifications are logged to the
# console instead of sent — the site still works, emails just don't go
# out. Safe to leave unset until a real Resend account exists.
# RESEND_API_KEY=""
# RESEND_FROM_EMAIL="Appliance Desk <onboarding@resend.dev>"
# Where new-lead notifications are sent. Falls back to BusinessSettings'
# publicEmail (set in /desk/settings) if not given.
# LEAD_NOTIFICATION_EMAIL=""
# Where new-maintenance-request notifications are sent. Falls back to the
# same publicEmail if not given.
# MAINTENANCE_NOTIFICATION_EMAIL=""

# --- Payments (Phase 6B, Stripe TEST mode only) ---
# STRIPE_SECRET_KEY and NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY are set as
# real Vercel environment variables as of 2026-09-27 (test-mode keys --
# see docs/DECISIONS.md). Never real/live keys until Chris explicitly
# says to go live -- see AGENTS.md.
# STRIPE_SECRET_KEY=""
# NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=""
# The webhook signing secret Stripe gives back when you register the
# endpoint in its dashboard (needed to verify a webhook request really
# came from Stripe). Set as a real Vercel environment variable as of
# 2026-09-27 -- see docs/ARCHITECTURE.md's "Payments (Stripe)" section.
# STRIPE_WEBHOOK_SECRET=""

# --- Test fixtures (CI / e2e only -- never set these in production) ---
# Used only by prisma/seed.ts to create a throwaway CUSTOMER account for
# Playwright/axe accessibility tests to log in as. CI sets these itself
# (see .github/workflows/ci.yml); nothing to fill in for local dev
# unless you're running the accessibility e2e suite yourself.
# TEST_CUSTOMER_EMAIL=""
# TEST_CUSTOMER_PASSWORD=""
# TEST_CUSTOMER_NAME=""
