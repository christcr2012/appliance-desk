{
  "name": "appliance-desk",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "preflight": "node scripts/preflight.mjs",
    "check:preflight": "node --test scripts/build-recovery.test.mjs scripts/preflight.test.mjs scripts/probe-db.test.mjs scripts/check-cache.test.mjs scripts/check-route-inventory.test.mjs scripts/vercel-ignore-build.test.mjs scripts/work-session.test.mjs scripts/preflight-evidence.test.mjs scripts/check-secrets.test.mjs scripts/check-owner-wording.test.mjs scripts/install-worktree.test.mjs && npm run check:session",
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint && node scripts/check-e2-ui-tokens.mjs && node scripts/check-w18-money.mjs && node scripts/check-owner-wording.mjs",
    "typecheck": "next typegen && tsc --noEmit",
    "postinstall": "prisma generate",
    "db:migrate:deploy": "prisma migrate deploy",
    "db:migrate:dev": "prisma migrate dev",
    "db:studio": "prisma studio",
    "db:seed": "tsx prisma/seed.ts",
    "db:reset-test-data": "tsx scripts/reset-test-data.ts",
    "check:migrations": "node scripts/check-migrations.mjs",
    "db:verify-schema-health": "tsx scripts/verify-schema-health.ts",
    "vercel-build": "npm run check:migrations && npm run db:migrate:deploy && npm run db:verify-schema-health && npm run build",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "hooks:install": "bash scripts/setup-checkout.sh",
    "setup": "bash scripts/setup-checkout.sh",
    "sandbox:browser": "bash scripts/sandbox-browser-setup.sh",
    "test:db": "node scripts/preflight.mjs --db",
    "test:db:probe": "node scripts/probe-db.mjs",
    "test:browser": "node scripts/preflight.mjs --browser",
    "check:quick": "node scripts/preflight.mjs --quick",
    "work": "node scripts/work-session.mjs",
    "check:work": "node scripts/work-session.mjs check",
    "session:status": "node scripts/session-status.mjs",
    "check:session": "node --test scripts/session-prepare.test.mjs scripts/check-ci-layout.test.mjs scripts/ci-phase.test.mjs scripts/bundle-plan.test.mjs scripts/completion-evidence.test.mjs scripts/release-needed.test.mjs scripts/session-status.test.mjs scripts/pr-progress.test.mjs && node scripts/session-status.mjs && node scripts/pr-progress.mjs --check && node scripts/check-ci-layout.mjs",
    "pr:progress": "node scripts/pr-progress.mjs",
    "session:bundle": "node scripts/bundle-plan.mjs",
    "session:prepare": "node scripts/session-prepare.mjs",
    "ledger": "node scripts/launch-ledger.mjs",
    "bundle:preflight": "node scripts/bundle-preflight.mjs",
    "bundle:new": "node scripts/bundle-new.mjs"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.9.1",
    "@prisma/adapter-neon": "^7.10.0",
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "@sentry/nextjs": "11.8.0",
    "@vercel/blob": "^2.8.0",
    "@vercel/speed-insights": "^2.0.0",
    "better-auth": "^1.7.6",
    "date-fns": "^4.4.0",
    "next": "16.4.2",
    "pdf-lib": "^1.17.1",
    "pg": "^8.23.0",
    "prisma": "^7.10.0",
    "qrcode": "^1.5.4",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-hook-form": "^7.89.0",
    "resend": "^6.30.0",
    "sharp": "^0.35.5",
    "stripe": "^22.6.2",
    "twilio": "^6.1.2",
    "ws": "^8.22.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26.6.3",
    "@types/pg": "^8.23.1",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "^6.1.1",
    "eslint": "^9",
    "eslint-config-next": "16.4.2",
    "jsdom": "^30.1.1",
    "prettier": "^3.9.9",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^5.0.2"
  },
  "overrides": {
    "mysql2": "^3.24.4",
    "deepmerge-ts": "^8.0.2"
  },
  "allowScripts": {
    "@prisma/engines": true,
    "prisma": true,
    "esbuild": true,
    "unrs-resolver": true
  }
}
